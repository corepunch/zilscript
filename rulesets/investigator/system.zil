;"Skill percentages and bounded composure. System rules only."
<CONSTANT A-MEDICINE 1>
<CONSTANT A-INTERVIEW 2>
<CONSTANT A-REPAIR 3>
<CONSTANT A-COMPOSURE 4>
<CONSTANT INV-REGULAR 1>
<CONSTANT INV-HARD 2>
<CONSTANT INV-EXTREME 5>
<CONSTANT INV-READY 0>
<CONSTANT INV-FAILED 1>
<CONSTANT INV-SOLVED 2>
<CONSTANT INV-SPENT 3>

<GLOBAL SHEET-LAYOUT <LTABLE A-MEDICINE A-INTERVIEW A-REPAIR A-COMPOSURE>>
<GLOBAL STATUS-LAYOUT <LTABLE A-COMPOSURE>>

<ROUTINE SYSTEM-DERIVE (TBL)
 <SET-RESOURCE .TBL ,A-COMPOSURE <STAT .TBL ,A-COMPOSURE>>>

<ROUTINE INV-TARGET (VALUE DIFFICULTY)
 <COND (<OR <L? .VALUE 0> <G? .VALUE 100>
            <NOT <EQUAL? .DIFFICULTY ,INV-REGULAR ,INV-HARD ,INV-EXTREME>>> 0)
       (T </ .VALUE .DIFFICULTY>)>>

<ROUTINE SYSTEM-ROLL (TBL ATTR DIFFICULTY) <ROLL 1 100>>

<ROUTINE SYSTEM-GRADE (TBL ATTR DIFFICULTY ROLL)
 <COND (<AND <G? .ROLL 0> <NOT <G? .ROLL <INV-TARGET <STAT .TBL .ATTR> .DIFFICULTY>>>> 1)
       (T 0)>>

;"Book-owned one-cell attempt record, shared by all approaches to one
  opportunity. Invalid or repeated actions consume no roll. -1 is blocked."
<ROUTINE INV-ATTEMPT (STATE TBL ATTR DIFFICULTY PUSH?)
 <COND (<NOT <==? <GET .STATE 0> <COND (.PUSH? ,INV-FAILED) (T ,INV-READY)>>>
        -1)
       (<CHECK .TBL .ATTR .DIFFICULTY 1>
        <PUT .STATE 0 ,INV-SOLVED> 1)
       (T <PUT .STATE 0 <COND (.PUSH? ,INV-SPENT) (T ,INV-FAILED)>> 0)>>

;"The adventure chooses when a shock may happen and supplies the two losses."
<ROUTINE INV-SHOCK (TBL SMALL LARGE "AUX" BEFORE)
 <SET BEFORE <STAT .TBL ,A-COMPOSURE>>
 <COND (<CHECK .TBL ,A-COMPOSURE ,INV-REGULAR 1>
        <LOSE .TBL ,A-COMPOSURE .SMALL>)
       (T <LOSE .TBL ,A-COMPOSURE .LARGE>)>
 <- .BEFORE <STAT .TBL ,A-COMPOSURE>>>
