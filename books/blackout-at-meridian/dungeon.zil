<DIRECTIONS NORTH EAST WEST SOUTH NE NW SE SW UP DOWN IN OUT LAND>
<GLOBAL HERO-CLASS 0>
<GLOBAL RESCUED <>>
<GLOBAL DRONE-HP 40>
<GLOBAL DISABLED <>>
<GLOBAL BOOSTED <>>
<GLOBAL HERO-NAME <ITABLE 33 (BYTE) 0>>
<ROOM DISPATCH (DESC "Dispatch") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (NORTH TO BRIDGE IF HERO-CLASS ELSE "Choose a profile first.") (ACTION DISPATCH-F)>
<ROOM BRIDGE (DESC "Meridian Bridge") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (SOUTH TO DISPATCH) (EAST TO RELAY IF RESCUED ELSE "The tram is still in danger.") (ACTION BRIDGE-F)>
<ROOM RELAY (DESC "Relay Station") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (WEST TO BRIDGE) (ACTION RELAY-F)>

<OBJECT VANGUARD (IN DISPATCH) (DESC "bulwark profile") (SYNONYM BULWARK PROFILE) (ADJECTIVE BULWARK) (FLAGS NDESCBIT TURNBIT) (ACTION PROFILE-F)>

<OBJECT ARC (IN DISPATCH) (DESC "arc profile") (SYNONYM ARC PROFILE) (ADJECTIVE ARC) (FLAGS NDESCBIT TURNBIT) (ACTION PROFILE-F)>

<OBJECT LENS (IN DISPATCH) (DESC "lens profile") (SYNONYM LENS PROFILE) (ADJECTIVE LENS) (FLAGS NDESCBIT TURNBIT) (ACTION PROFILE-F)>

<OBJECT DOSSIER (DESC "character sheet") (SYNONYM SHEET DOSSIER) (ADJECTIVE CHARACTER) (FLAGS NDESCBIT READBIT) (ACTION SHEET-F)>

<OBJECT TRAM (IN BRIDGE) (DESC "tram") (SYNONYM TRAM CARRIAGE PASSENGERS PEOPLE) (ADJECTIVE FRONT) (FLAGS NDESCBIT TURNBIT) (ACTION TRAM-F)>

<OBJECT DRONE (IN RELAY) (DESC "guard drone") (SYNONYM DRONE) (ADJECTIVE GUARD) (FLAGS NDESCBIT ACTORBIT TURNBIT) (ACTION DRONE-F)>

<OBJECT CONSOLE (IN RELAY) (DESC "relay console") (SYNONYM CONSOLE) (ADJECTIVE RELAY) (FLAGS NDESCBIT TURNBIT) (ACTION CONSOLE-F)>

<OBJECT SUPPLIES (IN RELAY) (DESC "emergency kit") (SYNONYM KIT) (ADJECTIVE EMERGENCY) (FLAGS NDESCBIT TURNBIT) (ACTION KIT-F)>
