<DIRECTIONS NORTH EAST WEST SOUTH NE NW SE SW UP DOWN IN OUT LAND>
<GLOBAL HERO-CLASS 0>
<GLOBAL RESCUED <>>
<GLOBAL DRONE-HP 40>
<GLOBAL DISABLED <>>
<GLOBAL BOOSTED <>>
<GLOBAL HERO-NAME <ITABLE 33 (BYTE) 0>>
<ROOM DISPATCH (DESC "Dispatch") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (NORTH TO BRIDGE IF HERO-CLASS ELSE "Dispatch will not send an unregistered hero into the storm. Choose a profile first: Bulwark, Arc or Lens.")
 (OUT TO BRIDGE IF HERO-CLASS ELSE "Dispatch will not send an unregistered hero into the storm. Choose a profile first: Bulwark, Arc or Lens.")
 (GLOBAL RAIN CITY RIVER BRIDGE-SPAN DISTANT-TRAM) (ACTION DISPATCH-F)>
<ROOM BRIDGE (DESC "Meridian Bridge") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (SOUTH TO DISPATCH)
 (EAST TO RELAY IF RESCUED ELSE "Not while the passengers are hanging over the river. Rescue them first.")
 (DOWN "The crew has the riverbank. The passengers need you up here.")
 (GLOBAL RAIN CITY RIVER BRIDGE-SPAN STATION STATION-DOOR) (ACTION BRIDGE-F)>
<ROOM RELAY (DESC "Relay Station") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (WEST TO BRIDGE) (OUT TO BRIDGE)
 (GLOBAL RAIN CITY RIVER BRIDGE-SPAN STATION STATION-DOOR) (ACTION RELAY-F)>

;"The profile cards on the duty board. PROFILE comes first among the
  synonyms so a disambiguation link reads as a profile, not a doubled word."
<OBJECT VANGUARD (IN DISPATCH) (DESC "Bulwark profile") (SYNONYM PROFILE BULWARK CARD) (ADJECTIVE BULWARK) (FLAGS NDESCBIT) (ACTION PROFILE-F)>

<OBJECT ARC (IN DISPATCH) (DESC "Arc profile") (SYNONYM PROFILE ARC CARD) (ADJECTIVE ARC) (FLAGS NDESCBIT) (ACTION PROFILE-F)>

<OBJECT LENS (IN DISPATCH) (DESC "Lens profile") (SYNONYM PROFILE LENS CARD) (ADJECTIVE LENS) (FLAGS NDESCBIT) (ACTION PROFILE-F)>

<OBJECT DUTY-BOARD (IN DISPATCH) (DESC "duty board") (SYNONYM BOARD) (ADJECTIVE DUTY) (FLAGS NDESCBIT) (ACTION DUTY-BOARD-F)>

<OBJECT WINDOW (IN DISPATCH) (DESC "window") (SYNONYM WINDOW GLASS) (FLAGS NDESCBIT) (ACTION WINDOW-F)>

<OBJECT DOSSIER (DESC "character sheet") (SYNONYM SHEET DOSSIER) (ADJECTIVE CHARACTER) (FLAGS TAKEBIT READBIT) (ACTION SHEET-F)>

<OBJECT TRAM (IN BRIDGE) (DESC "tram") (SYNONYM TRAM CARRIAGE PASSENGERS PEOPLE) (ADJECTIVE FRONT) (FLAGS NDESCBIT) (ACTION TRAM-F)>

<OBJECT CREW (IN BRIDGE) (DESC "rescue crew") (SYNONYM CREW RESCUERS NET CHIEF) (ADJECTIVE RESCUE) (FLAGS NDESCBIT ACTORBIT) (ACTION CREW-F)>

<OBJECT RAILS (IN BRIDGE) (DESC "rails") (SYNONYM RAILS RAIL RAILING TRACKS) (ADJECTIVE BENT BROKEN) (FLAGS NDESCBIT) (ACTION RAILS-F)>

<OBJECT CABLE (IN BRIDGE) (DESC "cable") (SYNONYM CABLE WIRE) (ADJECTIVE OVERHEAD SAGGING) (FLAGS NDESCBIT) (ACTION CABLE-F)>

<OBJECT DRONE (IN RELAY) (DESC "guard drone") (SYNONYM DRONE EYE) (ADJECTIVE GUARD RED) (FLAGS NDESCBIT ACTORBIT) (ACTION DRONE-F)>

<OBJECT CONSOLE (IN RELAY) (DESC "relay console") (SYNONYM CONSOLE RELAY LEVER SCREENS) (ADJECTIVE RELAY MANUAL) (FLAGS NDESCBIT) (ACTION CONSOLE-F)>

<OBJECT SUPPLIES (IN RELAY) (DESC "emergency kit") (SYNONYM KIT) (ADJECTIVE EMERGENCY RECOVERY) (FLAGS NDESCBIT) (ACTION KIT-F)>

;"Scenery the prose names in more than one room."
<OBJECT RAIN (IN LOCAL-GLOBALS) (DESC "rain") (SYNONYM RAIN STORM) (FLAGS NDESCBIT) (ACTION RAIN-F)>

<OBJECT CITY (IN LOCAL-GLOBALS) (DESC "city") (SYNONYM CITY MERIDIAN SKYLINE POWER) (ADJECTIVE DARK) (FLAGS NDESCBIT) (ACTION CITY-F)>

<OBJECT RIVER (IN LOCAL-GLOBALS) (DESC "river") (SYNONYM RIVER CURRENT) (FLAGS NDESCBIT) (ACTION RIVER-F)>

<OBJECT BRIDGE-SPAN (IN LOCAL-GLOBALS) (DESC "bridge") (SYNONYM BRIDGE) (ADJECTIVE MERIDIAN) (FLAGS NDESCBIT) (ACTION BRIDGE-SPAN-F)>

<OBJECT DISTANT-TRAM (IN LOCAL-GLOBALS) (DESC "tram") (SYNONYM TRAM) (ADJECTIVE DISTANT) (FLAGS NDESCBIT) (ACTION DISTANT-TRAM-F)>

<OBJECT STATION (IN LOCAL-GLOBALS) (DESC "relay station") (SYNONYM STATION BUILDING HALL) (ADJECTIVE RELAY CONCRETE) (FLAGS NDESCBIT) (ACTION STATION-F)>

<OBJECT STATION-DOOR (IN LOCAL-GLOBALS) (DESC "station door") (SYNONYM DOOR DOORWAY) (ADJECTIVE STATION STEEL) (FLAGS NDESCBIT) (ACTION STATION-DOOR-F)>
