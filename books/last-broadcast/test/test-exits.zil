	<CO-RESUME ,CO "south">
	<ASSERT "LB-HALL SOUTH LB-LANDING" <EQUAL? ,HERE ,LB-LANDING>>
	<CO-RESUME ,CO "north">
	<ASSERT "Return LB-LANDING NORTH LB-HALL" <EQUAL? ,HERE ,LB-HALL>>
	<SETG HERE ,LB-OFFICE> <MOVE ,WINNER ,HERE>
