<INSERT-FILE "books/last-broadcast/last-broadcast">
<GLOBAL CO <CO-CREATE GO>>

<ROUTINE RUN-TEST ()
	<FSET ,LB-HATCH ,OPENBIT>
	<SETG HERE ,LB-LANDING> <MOVE ,WINNER ,HERE>
	<CO-RESUME ,CO "north">
	<ASSERT "LB-LANDING NORTH LB-HALL" <EQUAL? ,HERE ,LB-HALL>>
	<CO-RESUME ,CO "south">
	<ASSERT "Return LB-HALL SOUTH LB-LANDING" <EQUAL? ,HERE ,LB-LANDING>>
	<SETG HERE ,LB-HALL> <MOVE ,WINNER ,HERE>
	<CO-RESUME ,CO "north">
	<ASSERT "LB-HALL NORTH LB-OFFICE" <EQUAL? ,HERE ,LB-OFFICE>>
	<CO-RESUME ,CO "south">
	<ASSERT "Return LB-OFFICE SOUTH LB-HALL" <EQUAL? ,HERE ,LB-HALL>>
	<SETG HERE ,LB-HALL> <MOVE ,WINNER ,HERE>
	<CO-RESUME ,CO "east">
	<ASSERT "LB-HALL EAST LB-STUDIO" <EQUAL? ,HERE ,LB-STUDIO>>
	<CO-RESUME ,CO "west">
	<ASSERT "Return LB-STUDIO WEST LB-HALL" <EQUAL? ,HERE ,LB-HALL>>
	<SETG HERE ,LB-HALL> <MOVE ,WINNER ,HERE>
	<CO-RESUME ,CO "west">
	<ASSERT "LB-HALL WEST LB-KITCHEN" <EQUAL? ,HERE ,LB-KITCHEN>>
	<CO-RESUME ,CO "east">
	<ASSERT "Return LB-KITCHEN EAST LB-HALL" <EQUAL? ,HERE ,LB-HALL>>
	<SETG HERE ,LB-HALL> <MOVE ,WINNER ,HERE>
	<CO-RESUME ,CO "up">
	<ASSERT "LB-HALL UP LB-BUNKROOM" <EQUAL? ,HERE ,LB-BUNKROOM>>
	<CO-RESUME ,CO "down">
	<ASSERT "Return LB-BUNKROOM DOWN LB-HALL" <EQUAL? ,HERE ,LB-HALL>>
