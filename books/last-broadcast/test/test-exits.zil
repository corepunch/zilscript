	<CO-RESUME ,CO "up">
	<ASSERT "Return LB-TELEGRAPH UP LB-PLATFORM" <EQUAL? ,HERE ,LB-PLATFORM>>
	<SETG HERE ,LB-PLATFORM> <MOVE ,WINNER ,HERE>
	<CO-RESUME ,CO "east">
