<DIRECTIONS NORTH EAST WEST SOUTH NE NW SE SW UP DOWN IN OUT>
<GLOBAL LB-WON <>>
<GLOBAL LB-CLOCK <>>
<GLOBAL LB-SOUND <>>
<GLOBAL LB-PROVENANCE <>>
<GLOBAL LB-TRACE <>>
<GLOBAL LB-WEAPON <>>
<GLOBAL LB-ROUTE <>>
<GLOBAL LB-RUTH-CLEARED <>>
<GLOBAL LB-EDITH-CLEARED <>>
<GLOBAL LB-TOMAS-CLEARED <>>
<GLOBAL LB-MOTIVE <>>
<GLOBAL LB-RECONSTRUCTED <>>
<GLOBAL LB-STAIN-SEEN <>>
<GLOBAL LB-LEDGER-SEEN <>>
<GLOBAL LB-DRESSING-SEEN <>>
<GLOBAL LB-RECEIPT-SEEN <>>

<ROOM LB-LANDING (IN ROOMS) (DESC "Saint Bride Landing")
	(LDESC "Salt dries white on the [[station clock]]. Beyond it, the [[hall->north]] shines with electric warmth. The sea is making quite enough noise for everyone.")
	(NORTH TO LB-HALL) (FLAGS RLANDBIT ONBIT)>
<ROOM LB-HALL (IN ROOMS) (DESC "Station Hall")
	(LDESC "Warm varnish smells faintly of fish. An [[appeal board]] faces the [[office->north]]; [[studio->east]] and [[kitchen->west]] flank the hall. The [[bunkroom->up]] is upstairs; the [[landing->south]] is behind you.")
	(NORTH TO LB-OFFICE) (EAST TO LB-STUDIO) (WEST TO LB-KITCHEN) (UP TO LB-BUNKROOM) (SOUTH TO LB-LANDING) (FLAGS RLANDBIT ONBIT)>
<ROOM LB-OFFICE (IN ROOMS) (DESC "Vane's Office")
	(ACTION LB-OFFICE-F)
	(SOUTH TO LB-HALL) (DOWN TO LB-PASSAGE IF LB-HATCH IS OPEN ELSE "The [[hatch]] is bolted shut; its square spindle takes a spanner.") (GLOBAL LB-HATCH) (FLAGS RLANDBIT ONBIT)>
<ROOM LB-STUDIO (IN ROOMS) (DESC "Broadcast Studio")
	(LDESC "The felt smells of old tobacco. [[Ruth]] stands beside a [[microphone]], keeping her voice low for a machine that is no longer listening. The [[hall->west]] is west, the [[control room->east]] east.")
	(WEST TO LB-HALL) (EAST TO LB-CONTROL) (GLOBAL LB-VANE LB-BROADCAST) (FLAGS RLANDBIT ONBIT)>
<ROOM LB-CONTROL (IN ROOMS) (DESC "Control Room")
	(LDESC "The [[gramophone]] stands under a green-shaded light. A [[routing switch]] occupies the place of honour. The [[studio->west]] is west, the [[cutting room->north]] north, the [[workshop->south]] south.")
	(WEST TO LB-STUDIO) (NORTH TO LB-CUTTING) (SOUTH TO LB-WORKSHOP) (FLAGS RLANDBIT ONBIT)>
<ROOM LB-CUTTING (IN ROOMS) (DESC "Disc Cutting Room")
	(LDESC "A curl of lacquer has dried beside the [[cutter]]. Its [[register]] rests on a sloping stand. The [[control room->south]] lies south; the cooler [[archive->east]] is east.")
	(SOUTH TO LB-CONTROL) (EAST TO LB-ARCHIVE) (FLAGS RLANDBIT ONBIT)>
<ROOM LB-ARCHIVE (IN ROOMS) (DESC "Record Archive")
	(LDESC "Cold paper gives the room the smell of a closed church. Only the [[cutting room->west]] leads out.")
	(WEST TO LB-CUTTING) (FLAGS RLANDBIT ONBIT)>
<ROOM LB-WORKSHOP (IN ROOMS) (DESC "Service Workshop")
	(LDESC "The air tastes of solder. The [[control room->north]] is north; the [[generator room->down]] hums below.")
	(NORTH TO LB-CONTROL) (DOWN TO LB-GENERATOR) (FLAGS RLANDBIT ONBIT)>
<ROOM LB-GENERATOR (IN ROOMS) (DESC "Generator Room")
	(LDESC "The [[generator]] shudders on rubber feet. The [[workshop->up]] is above; a [[cable passage->north]] runs north beneath the office.")
	(UP TO LB-WORKSHOP) (NORTH TO LB-PASSAGE) (FLAGS RLANDBIT ONBIT)>
<ROOM LB-PASSAGE (IN ROOMS) (DESC "Cable Passage")
	(ACTION LB-PASSAGE-F)
	(SOUTH TO LB-GENERATOR) (UP TO LB-OFFICE IF LB-HATCH IS OPEN ELSE "The [[hatch]] is bolted shut; a square spindle faces you.") (GLOBAL LB-HATCH) (FLAGS RLANDBIT ONBIT)>
<ROOM LB-KITCHEN (IN ROOMS) (DESC "Station Kitchen")
	(LDESC "Steam has softened the edges of everything. [[Edith]] sits at the scrubbed end of the [[table]]. The [[hall->east]] lies east; the [[telegraph room->west]] west.")
	(EAST TO LB-HALL) (WEST TO LB-TELEGRAPH) (GLOBAL LB-VANE LB-BROADCAST) (FLAGS RLANDBIT ONBIT)>
<ROOM LB-TELEGRAPH (IN ROOMS) (DESC "Telegraph Room")
	(LDESC "The [[telegraph]] clicks into a silence its [[operator->tomas]] seems unwilling to occupy. The [[kitchen->east]] is east. An iron stair reaches the [[aerial platform->up]].")
	(EAST TO LB-KITCHEN) (UP TO LB-PLATFORM) (GLOBAL LB-VANE LB-BROADCAST) (FLAGS RLANDBIT ONBIT)>
<ROOM LB-PLATFORM (IN ROOMS) (DESC "Aerial Platform")
	(LDESC "Rain beads along the [[aerial]]. A [[signal lamp]] makes a small, brave green circle on the wet iron. The [[telegraph room->down]] is below; a covered walk leads east to the [[bunkroom->east]].")
	(DOWN TO LB-TELEGRAPH) (EAST TO LB-BUNKROOM) (FLAGS RLANDBIT ONBIT)>
<ROOM LB-BUNKROOM (IN ROOMS) (DESC "Staff Bunkroom")
	(LDESC "Soap and wet wool. [[Ada]] sits rigid beneath a [[maintenance roster]]. The [[hall->down]] is downstairs; the covered walk goes west to the [[aerial platform->west]].")
	(DOWN TO LB-HALL) (WEST TO LB-PLATFORM) (GLOBAL LB-VANE LB-BROADCAST) (FLAGS RLANDBIT ONBIT)>

<OBJECT LB-CASEBOOK (IN ADVENTURER) (DESC "casebook") (SYNONYM CASEBOOK NOTEBOOK CASE) (FLAGS TAKEBIT) (SIZE 0) (INTERACTIONS "") (ACTION LB-CASEBOOK-F)>
<OBJECT LB-STATION-CLOCK (IN LB-LANDING) (DESC "station clock") (SYNONYM CLOCK TIME) (ADJECTIVE STATION) (FLAGS NDESCBIT) (INTERACTIONS "") (ACTION LB-STATION-CLOCK-F)>

<OBJECT LB-BOARD (IN LB-HALL) (DESC "appeal board") (SYNONYM BOARD SCHEDULE) (ADJECTIVE APPEAL) (FLAGS NDESCBIT READBIT) (INTERACTIONS "") (ACTION LB-BOARD-F)>
<OBJECT LB-OFFICE-CLOCK (IN LB-OFFICE) (DESC "office clock") (SYNONYM CLOCK) (ADJECTIVE OFFICE ELECTRIC) (FLAGS NDESCBIT) (INTERACTIONS "COMPARE:LB-CHART") (ACTION LB-OFFICE-CLOCK-F)>
<OBJECT LB-BODY (IN LB-OFFICE) (DESC "Julian Vane's body") (SYNONYM BODY CORPSE JULIAN WOUND EAR) (ADJECTIVE JULIAN VANE DEAD) (FLAGS NDESCBIT) (INTERACTIONS "COMPARE:LB-WEIGHT") (ACTION LB-BODY-F)>
<OBJECT LB-HATCH (IN LOCAL-GLOBALS) (DESC "service hatch") (SYNONYM HATCH SPINDLE BOLT) (ADJECTIVE SERVICE SQUARE) (FLAGS NDESCBIT DOORBIT) (INTERACTIONS "USE-WITH:LB-SPANNER,LB-STYLUS;OPEN:LB-SPANNER;UNLOCK:LB-SPANNER") (ACTION LB-HATCH-F)>
<OBJECT LB-RUTH (IN LB-STUDIO) (DESC "Ruth Bell") (SYNONYM BELL RUTH ANNOUNCER WOMAN) (ADJECTIVE RUTH) (FLAGS NDESCBIT ACTORBIT ARTICLEBIT) (INTERACTIONS "TELL:LB-MICROPHONE,LB-BROADCAST,LB-VANE,LB-DISC;SHOW:LB-DISC") (ACTION LB-RUTH-F)>
<OBJECT LB-MICROPHONE (IN LB-STUDIO) (DESC "microphone") (SYNONYM MICROPHONE MIKE LAMP) (ADJECTIVE RED STUDIO) (FLAGS NDESCBIT) (INTERACTIONS "") (ACTION LB-MICROPHONE-F)>
<OBJECT LB-PLAYER (IN LB-CONTROL) (DESC "gramophone") (SYNONYM GRAMOPHONE PLAYER TURNTABLE) (FLAGS NDESCBIT CONTBIT OPENBIT SEARCHBIT) (CAPACITY 50) (INTERACTIONS "USE-WITH:LB-STYLUS,LB-SPANNER") (ACTION LB-PLAYER-F)>
<OBJECT LB-SWITCH (IN LB-CONTROL) (DESC "routing switch") (SYNONYM SWITCH ROUTING LEVER) (ADJECTIVE ROUTING) (FLAGS NDESCBIT) (INTERACTIONS "") (ACTION LB-SWITCH-F)>
<OBJECT LB-CUTTER (IN LB-CUTTING) (DESC "disc cutter") (SYNONYM CUTTER MACHINE LACQUER) (ADJECTIVE DISC) (FLAGS NDESCBIT CONTBIT SEARCHBIT) (CAPACITY 20) (INTERACTIONS "") (ACTION LB-CUTTER-F)>
<OBJECT LB-REGISTER (IN LB-CUTTING) (DESC "cutter register") (SYNONYM REGISTER LOG) (ADJECTIVE CUTTER CUTTING) (FLAGS NDESCBIT READBIT) (INTERACTIONS "COMPARE:LB-DISC") (ACTION LB-REGISTER-F)>
<OBJECT LB-SLEEVE (IN LB-ARCHIVE) (DESC "cardboard sleeve") (SYNONYM SLEEVE ENVELOPE CARDBOARD) (ADJECTIVE CARDBOARD RECORD) (FLAGS CONTBIT SEARCHBIT) (CAPACITY 30) (LDESC "A [[cardboard sleeve]] lies within reach.") (INTERACTIONS "") (ACTION LB-SLEEVE-F)>
<OBJECT LB-DISC (IN LB-SLEEVE) (DESC "lacquer disc") (SYNONYM DISC RECORD GROOVE EDGE) (ADJECTIVE LACQUER RECORDED APPEAL) (FLAGS TAKEBIT READBIT) (SIZE 2) (LDESC "A [[lacquer disc]] lies here.") (INTERACTIONS "PUT:LB-PLAYER,LB-SLEEVE;COMPARE:LB-REGISTER;SHOW:LB-RUTH,LB-ADA") (ACTION LB-DISC-F)>
<OBJECT LB-LEDGER (IN LB-ARCHIVE) (DESC "wage ledger") (SYNONYM LEDGER WAGES WAGE ACCOUNTS) (ADJECTIVE WAGE) (FLAGS TAKEBIT READBIT) (SIZE 1) (LDESC "A [[wage ledger]] lies here.") (INTERACTIONS "SHOW:LB-ADA") (ACTION LB-LEDGER-F)>
<OBJECT LB-STYLUS (IN LB-WORKSHOP) (DESC "playback stylus") (SYNONYM STYLUS NEEDLE) (ADJECTIVE PLAYBACK STEEL) (FLAGS TAKEBIT) (SIZE 0) (LDESC "A [[playback stylus]] lies here.") (INTERACTIONS "USE-ON:LB-PLAYER,LB-HATCH") (ACTION LB-STYLUS-F)>
<OBJECT LB-SPANNER (IN LB-WORKSHOP) (DESC "service spanner") (SYNONYM SPANNER WRENCH TOOL) (ADJECTIVE SERVICE SQUARE) (FLAGS TAKEBIT TOOLBIT) (SIZE 1) (LDESC "A [[service spanner]] lies here.") (INTERACTIONS "USE-ON:LB-HATCH,LB-PLAYER") (ACTION LB-SPANNER-F)>
<OBJECT LB-GENERATOR-MACHINE (IN LB-GENERATOR) (DESC "lighting generator") (SYNONYM GENERATOR DIESEL MOTOR) (ADJECTIVE LIGHTING) (FLAGS NDESCBIT) (INTERACTIONS "") (ACTION LB-GENERATOR-F)>
<OBJECT LB-CHART (IN LB-GENERATOR) (DESC "voltage chart") (SYNONYM CHART TRACE VOLTAGE) (ADJECTIVE VOLTAGE GENERATOR) (FLAGS TAKEBIT READBIT) (SIZE 0) (LDESC "A [[voltage chart]] lies here.") (INTERACTIONS "COMPARE:LB-OFFICE-CLOCK") (ACTION LB-CHART-F)>
<OBJECT LB-STAIN (IN LB-PASSAGE) (DESC "passage stain") (SYNONYM STAIN BLOOD PRINT FOOTPRINT HEEL) (ADJECTIVE PASSAGE HEEL) (FLAGS NDESCBIT) (INTERACTIONS "COMPARE:LB-BOOTS") (ACTION LB-STAIN-F)>
<OBJECT LB-EDITH (IN LB-KITCHEN) (DESC "Dr Edith Shaw") (SYNONYM SHAW EDITH DOCTOR PHYSICIAN) (ADJECTIVE EDITH DR) (FLAGS NDESCBIT ACTORBIT ARTICLEBIT) (INTERACTIONS "TELL:LB-BAG,LB-DRESSING,LB-BROADCAST,LB-VANE;SHOW:LB-DRESSING") (ACTION LB-EDITH-F)>
<OBJECT LB-TABLE (IN LB-KITCHEN) (DESC "kitchen table") (SYNONYM TABLE KETTLE CUP TEA) (ADJECTIVE KITCHEN) (FLAGS NDESCBIT) (INTERACTIONS "") (ACTION LB-TABLE-F)>
<OBJECT LB-BAG (IN LB-KITCHEN) (DESC "medical bag") (SYNONYM BAG SATCHEL) (ADJECTIVE MEDICAL LEATHER) (FLAGS CONTBIT SEARCHBIT) (CAPACITY 20) (LDESC "A [[medical bag]] rests here.") (INTERACTIONS "") (ACTION LB-BAG-F)>
<OBJECT LB-DRESSING (IN LB-BAG) (DESC "bloodied dressing") (SYNONYM DRESSING BANDAGE GAUZE) (ADJECTIVE BLOODIED MEDICAL) (FLAGS TAKEBIT READBIT) (SIZE 0) (LDESC "A [[bloodied dressing]] lies here.") (INTERACTIONS "SHOW:LB-EDITH") (ACTION LB-DRESSING-F)>
<OBJECT LB-TOMAS (IN LB-TELEGRAPH) (DESC "Tomas Vale") (SYNONYM VALE TOMAS OPERATOR MAN) (ADJECTIVE TOMAS) (FLAGS NDESCBIT ACTORBIT ARTICLEBIT) (INTERACTIONS "TELL:LB-RECEIPT,LB-BROADCAST,LB-VANE;SHOW:LB-RECEIPT") (ACTION LB-TOMAS-F)>
<OBJECT LB-TELEGRAPH-MACHINE (IN LB-TELEGRAPH) (DESC "telegraph") (SYNONYM TELEGRAPH KEY SOUNDER TAPE) (FLAGS NDESCBIT) (INTERACTIONS "") (ACTION LB-TELEGRAPH-F)>
<OBJECT LB-RECEIPT (IN LB-TELEGRAPH) (DESC "telegraph receipt") (SYNONYM RECEIPT TRANSMISSION STRIP) (ADJECTIVE TELEGRAPH STAMPED) (FLAGS TAKEBIT READBIT) (SIZE 0) (LDESC "A [[telegraph receipt]] lies here.") (INTERACTIONS "SHOW:LB-TOMAS") (ACTION LB-RECEIPT-F)>
<OBJECT LB-AERIAL (IN LB-PLATFORM) (DESC "aerial") (SYNONYM AERIAL ANTENNA WIRE RAIN) (FLAGS NDESCBIT) (INTERACTIONS "") (ACTION LB-AERIAL-F)>
<OBJECT LB-LAMP (IN LB-PLATFORM) (DESC "signal lamp") (SYNONYM LAMP SIGNAL LIGHT) (ADJECTIVE SIGNAL GREEN) (FLAGS NDESCBIT) (INTERACTIONS "") (ACTION LB-LAMP-F)>
<OBJECT LB-ADA (IN LB-BUNKROOM) (DESC "Ada Mercer") (SYNONYM MERCER ADA ENGINEER WOMAN) (ADJECTIVE ADA) (FLAGS NDESCBIT ACTORBIT ARTICLEBIT) (INTERACTIONS "TELL:LB-BOOTS,LB-ROSTER,LB-DISC,LB-WEIGHT,LB-BROADCAST,LB-VANE,LB-LEDGER,LB-STAIN;SHOW:LB-LEDGER,LB-DISC,LB-BOOTS,LB-WEIGHT") (ACTION LB-ADA-F)>
<OBJECT LB-BOOTS (IN LB-BUNKROOM) (DESC "pair of leather boots") (SYNONYM BOOTS BOOT SOLES PATCH REPAIR) (ADJECTIVE LEATHER ADA) (FLAGS TAKEBIT) (SIZE 1) (LDESC "A pair of [[leather boots]] stands here.") (INTERACTIONS "COMPARE:LB-STAIN;SHOW:LB-ADA") (ACTION LB-BOOTS-F)>
<OBJECT LB-ROSTER (IN LB-BUNKROOM) (DESC "maintenance roster") (SYNONYM ROSTER MAINTENANCE DUTY) (ADJECTIVE MAINTENANCE) (FLAGS NDESCBIT READBIT) (INTERACTIONS "") (ACTION LB-ROSTER-F)>
<OBJECT LB-VANE (IN LOCAL-GLOBALS) (DESC "Julian Vane") (SYNONYM VANE OWNER JULIAN) (ADJECTIVE JULIAN) (FLAGS NDESCBIT) (INTERACTIONS "") (ACTION LB-VANE-F)>
<OBJECT LB-BROADCAST (IN LOCAL-GLOBALS) (DESC "broadcast") (SYNONYM BROADCAST APPEAL ALIBI VOICE SOUND MURDER) (FLAGS NDESCBIT) (INTERACTIONS "") (ACTION LB-BROADCAST-F)>

<OBJECT LB-WEIGHT (IN LB-CUTTER) (DESC "brass counterweight") (SYNONYM COUNTERWEIGHT WEIGHT BRASS RIM DUST) (ADJECTIVE BRASS CUTTER) (FLAGS TAKEBIT) (SIZE 1) (LDESC "A [[brass counterweight]] rests here.") (INTERACTIONS "COMPARE:LB-BODY;SHOW:LB-ADA") (ACTION LB-WEIGHT-F)>
