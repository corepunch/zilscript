<DIRECTIONS NORTH EAST WEST SOUTH NE NW SE SW UP DOWN IN OUT LAND>
<GLOBAL FLOWING <>>
<GLOBAL WET-WICK <>>
<GLOBAL PATTERN-KNOWN <>>
<GLOBAL SPOUT-SEEN <>>
<ROOM COURT (DESC "Bell Court") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (EAST TO STORE) (NORTH TO SPRING) (ACTION COURT-F)>
<ROOM STORE (DESC "Reed Store") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (WEST TO COURT) (ACTION STORE-F)>
<ROOM SPRING (DESC "Spring Walk") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (SOUTH TO COURT) (EAST TO LANDING) (ACTION SPRING-F)>
<ROOM LANDING (DESC "Shutter Landing") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (WEST TO SPRING) (ACTION LANDING-F)>


<OBJECT BELL (IN COURT) (DESC "root bell") (SYNONYM BELL ROOT ROOTS SOCKET)
 (ADJECTIVE ROOT THIN OLD HOLLOW)
 (FLAGS NDESCBIT CONTBIT SEARCHBIT OPENBIT SURFACEBIT) (CAPACITY 20)
 (INTERACTIONS "ring,listen") (ACTION BELL-F)>

<OBJECT WICK (IN STORE) (DESC "reed wick") (SYNONYM WICK WICKS REED)
 (ADJECTIVE REED DRY WET DAMP)
 (FLAGS TAKEBIT) (SIZE 4)
 (INTERACTIONS "PUT:TROUGH,BELL") (ACTION WICK-F)>

<OBJECT TILE (IN STORE) (DESC "signal tile") (SYNONYM TILE SIGN DIAGRAM)
 (ADJECTIVE SIGNAL PAINTED OLD)
 (FLAGS NDESCBIT READBIT) (INTERACTIONS "read") (ACTION TILE-F)>

<OBJECT SPOUT (IN SPRING) (DESC "turning spout") (SYNONYM SPOUT TAP PIPE)
 (ADJECTIVE BRASS TURNING SPRING)
 (FLAGS NDESCBIT) (INTERACTIONS "turn") (ACTION SPOUT-F)>

<OBJECT TROUGH (IN SPRING) (DESC "soaking bowl") (SYNONYM BOWL BASIN TROUGH)
 (ADJECTIVE SOAKING STONE EMPTY FULL)
 (FLAGS NDESCBIT CONTBIT SEARCHBIT OPENBIT SURFACEBIT) (CAPACITY 20)
 (ACTION TROUGH-F)>

<OBJECT SHUTTER (IN LANDING) (DESC "frost shutter") (SYNONYM SHUTTER HATCH)
 (ADJECTIVE FROST OLD SQUARE)
 (FLAGS NDESCBIT DOORBIT)
 (INTERACTIONS "open,close") (ACTION SHUTTER-F)>

;"End of world data."
