; A visit to Taa II offers a third way to interrupt Doom's machine.
<GLOBAL BW-OFFER-SEEN <>>
<GLOBAL BW-OFFER-REFUSED <>>
<GLOBAL BW-PLAN-READ <>>
<GLOBAL BW-KLAW-FREE <>>
<ROOM BW-WORLDSHIP (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (SOUTH TO TOWER) (NORTH TO BW-CONVERTER) (ACTION BW-WORLDSHIP-F)>
<ROOM BW-CONVERTER (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (SOUTH TO BW-WORLDSHIP) (ACTION BW-CONVERTER-F)>
<OBJECT BW-OFFER (IN TOWER) (FLAGS NDESCBIT TRYTAKEBIT) (ACTION BW-OFFER-F)>
<OBJECT BW-KLAW (IN BW-WORLDSHIP) (FLAGS NDESCBIT ACTORBIT) (ACTION BW-KLAW-F)>
<OBJECT BW-PRISM (IN BW-WORLDSHIP) (FLAGS NDESCBIT TRYTAKEBIT) (ACTION BW-PRISM-F)>
<OBJECT BW-PLANS (IN BW-CONVERTER) (FLAGS NDESCBIT READBIT TRYTAKEBIT) (ACTION BW-PLANS-F)>
<OBJECT BW-REVERSE (IN BW-CONVERTER) (FLAGS NDESCBIT TURNBIT TRYTAKEBIT) (ACTION BW-REVERSE-F)>
<ROUTINE V-BW-ACCEPT () <MSG-BW-OFFER-FIRST>>
<ROUTINE V-BW-REFUSE () <MSG-BW-OFFER-FIRST>>
<ROUTINE BW-OFFER-F ()
 <COND (<EQUAL? ,PRSO ,BW-OFFER>
  <COND (<VERB? EXAMINE READ LISTEN> <SETG BW-OFFER-SEEN T> <MSG-BW-OFFER> <RTRUE>)
        (<VERB? BW-ACCEPT>
         <COND (<NOT ,BW-OFFER-SEEN> <MSG-BW-OFFER-FIRST>)
               (,BW-OFFER-REFUSED <MSG-BW-ALREADY-REFUSED>)
               (T <SETG BW-WON 4> <MSG-BW-ACCEPT-END> <FINISH>)> <RTRUE>)
        (<VERB? BW-REFUSE>
         <COND (<NOT ,BW-OFFER-SEEN> <MSG-BW-OFFER-FIRST>)
               (,BW-OFFER-REFUSED <MSG-BW-ALREADY-REFUSED>)
               (T <SETG BW-OFFER-REFUSED T> <GAIN ,HERO ,A-KARMA 5> <MSG-BW-REFUSED>)> <RTRUE>)>)>>
<ROUTINE BW-WORLDSHIP-F (RARG) <COND (<EQUAL? .RARG ,M-LOOK> <MSG-BW-WORLDSHIP> <RTRUE>)>>
<ROUTINE BW-CONVERTER-F (RARG) <COND (<EQUAL? .RARG ,M-LOOK> <MSG-BW-CONVERTER> <RTRUE>)>>
<ROUTINE BW-KLAW-F ()
 <COND (<EQUAL? ,PRSO ,BW-KLAW>
  <COND (<VERB? EXAMINE LISTEN TALK TELL ASK HELLO ANSWER>
         <MSG-BW-KLAW> <SETG P-CONT <>> <SETG QUOTE-FLAG <>> <RTRUE>)
        (<VERB? RPG-ATTACK PUSH> <MSG-BW-KLAW-STRIKE> <RTRUE>)>)>>
<ROUTINE BW-PRISM-F ()
 <COND (<EQUAL? ,PRSO ,BW-PRISM>
  <COND (<VERB? EXAMINE READ LISTEN TAKE> <MSG-BW-PRISM> <RTRUE>)
        (<VERB? OPEN USE TURN MOVE PUSH RPG-POWER RPG-DISABLE>
         <COND (,BW-KLAW-FREE <MSG-BW-PRISM-OPEN>)
               (T <SETG BW-KLAW-FREE T> <GAIN ,HERO ,A-KARMA 5> <MSG-BW-FREE>)> <RTRUE>)>)>>
<ROUTINE BW-PLANS-F ()
 <COND (<EQUAL? ,PRSO ,BW-PLANS>
  <COND (<VERB? EXAMINE READ SEARCH> <SETG BW-PLAN-READ T> <MSG-BW-PLANS> <RTRUE>)
        (<VERB? TAKE USE LISTEN> <MSG-BW-PLANS-HINT> <RTRUE>)>)>>
<ROUTINE BW-REVERSE-F ()
 <COND (<EQUAL? ,PRSO ,BW-REVERSE>
  <COND (<VERB? EXAMINE READ LISTEN TAKE> <MSG-BW-REVERSE> <RTRUE>)
        (<VERB? USE TURN MOVE PUSH PULL RPG-POWER RPG-DISABLE>
         <COND (<NOT ,BW-PLAN-READ> <MSG-BW-REVERSE-BLOCK>)
               (,BW-WON <RTRUE>)
               (T <SETG BW-WON 3> <GAIN ,HERO ,A-KARMA 20>
                  <COND (,BW-BELL-RUNG <MSG-VILLAGE-FAREWELL>)>
                  <MSG-BW-REVERSE-END> <FINISH>)> <RTRUE>)>)>>
