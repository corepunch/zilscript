<GLOBAL BW-WEIGHED <>>
<GLOBAL BW-BELL-RUNG <>>
<GLOBAL BW-HEALED <>>

<ROOM VILLAGE (IN ROOMS) (FLAGS RLANDBIT ONBIT) (EAST TO MARKET) (ACTION BW-VILLAGE-F)>
<OBJECT SCALES (IN MARKET) (FLAGS NDESCBIT TRYTAKEBIT) (ACTION BW-SCALES-F)>
<OBJECT CLAPPER (FLAGS TAKEBIT) (SIZE 1) (ACTION BW-CLAPPER-F)>
<OBJECT BELL (IN VILLAGE) (FLAGS NDESCBIT TRYTAKEBIT CONTBIT OPENBIT)
 (CAPACITY 1) (ACTION BW-BELL-F)>
<OBJECT ZSAJI (IN VILLAGE) (FLAGS ACTORBIT NDESCBIT) (ACTION BW-HEALER-F)>

<ROUTINE BW-VILLAGE-F (RARG)
 <COND (<EQUAL? .RARG ,M-LOOK> <MSG-VILLAGE> <RTRUE>)>>

<ROUTINE BW-SCALES-F ()
 <COND (<AND <EQUAL? ,PRSO ,SCALES> <VERB? EXAMINE SEARCH MOVE PUSH LOOK-UNDER USE>>
        <COND (<NOT ,BW-WEIGHED> <SETG BW-WEIGHED T> <MOVE ,CLAPPER ,MARKET> <MSG-FOUND-CLAPPER>)
              (T <MSG-EMPTY-SCALES>)> <RTRUE>)>>

<ROUTINE BW-CLAPPER-F ()
 <COND (<AND <EQUAL? ,PRSO ,CLAPPER> <IN? ,CLAPPER ,BELL> <VERB? TAKE PULL>>
        <MSG-BELL-FITTED> <RTRUE>)
       (<AND <EQUAL? ,PRSO ,CLAPPER> <VERB? EXAMINE READ>>
        <MSG-CLAPPER> <RTRUE>)>>

<ROUTINE BW-BELL-F ()
 <COND (<AND <VERB? PUT PUT-ON BW-FIT> <EQUAL? ,PRSO ,CLAPPER> <EQUAL? ,PRSI ,BELL>>
        <COND (<IN? ,CLAPPER ,WINNER> <MOVE ,CLAPPER ,BELL> <MSG-BELL-FITTED>)
              (T <MSG-BELL>)> <RTRUE>)
       (<EQUAL? ,PRSO ,BELL>
        <COND (<VERB? PULL RING USE MOVE PUSH BW-PULL>
               <COND (,BW-BELL-RUNG <MSG-ALL-HOME>)
                     (<IN? ,CLAPPER ,BELL> <SETG BW-BELL-RUNG T>
                      <GAIN ,HERO ,A-KARMA 5> <MSG-ANSWERING-BELLS>)
                     (T <MSG-BELL>)> <RTRUE>)
              (<VERB? EXAMINE LISTEN LOOK-INSIDE TAKE>
               <COND (,BW-BELL-RUNG <MSG-ALL-HOME>)
                     (<IN? ,CLAPPER ,BELL> <MSG-BELL-FITTED>)
                     (T <MSG-BELL>)> <RTRUE>)>)>>

<ROUTINE BW-HEALER-F ()
 <COND (<VERB? EXAMINE TALK TELL ASK HELLO LISTEN TOUCH>
        <SETG P-CONT <>> <SETG QUOTE-FLAG <>>
        <COND (<AND ,BW-RESCUE-TRIED ,BW-ASSISTED <NOT ,BW-HEALED>>
               <SETG BW-HEALED T> <GAIN ,HERO ,A-HEALTH 5> <MSG-HEALING>)>
        <MSG-ZSAJI> <RTRUE>)>>
