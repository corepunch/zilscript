<GLOBAL HERO-CLASS 0>
<GLOBAL RESCUED <>>
<GLOBAL DRONE-HP 40>
<GLOBAL DISABLED <>>
<GLOBAL BOOSTED <>>
<GLOBAL HERO-NAME <ITABLE 33 (BYTE) 0>>

<ROOM DISPATCH (DESC "Leitstelle") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (NORD TO BRIDGE IF HERO-CLASS ELSE "Die Leitstelle schickt keinen unangemeldeten Helden in den Sturm. W%ahle zuerst ein Profil: Fels, Blitz oder Luchs.")
 (RAUS TO BRIDGE IF HERO-CLASS ELSE "Die Leitstelle schickt keinen unangemeldeten Helden in den Sturm. W%ahle zuerst ein Profil: Fels, Blitz oder Luchs.")
 (GLOBAL RAIN CITY RIVER BRIDGE-SPAN DISTANT-TRAM) (ACTION DISPATCH-F)>
<ROOM BRIDGE (DESC "Meridian-Br%ucke") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (SUED TO DISPATCH)
 (OST TO RELAY IF RESCUED ELSE "Nicht, solange die Fahrg%aste %uber dem Fluss h%angen. Rette sie zuerst.")
 (RUNTER "Die Mannschaft sichert das Flussufer. Die Fahrg%aste brauchen dich hier oben.")
 (GLOBAL RAIN CITY RIVER BRIDGE-SPAN STATION STATION-DOOR) (ACTION BRIDGE-F)>
<ROOM RELAY (DESC "Relaisstation") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
 (WEST TO BRIDGE) (RAUS TO BRIDGE)
 (GLOBAL RAIN CITY RIVER BRIDGE-SPAN STATION STATION-DOOR) (ACTION RELAY-F)>

;"The objects have no ADJECTIVE lists: the German parser compares an
  adjective with the object's list by word, not by number, and finds no match
  (languages/de/parser.zil THIS-IT?), so every noun stands alone. The cards
  list KARTE and PROFIL first so a disambiguation link reads as a card."
<OBJECT VANGUARD (IN DISPATCH) (DESC "Fels-Karte") (SYNONYM KARTE PROFIL FELS FELSKARTE FELS-KARTE) (FLAGS NDESCBIT DIEBIT) (ACTION PROFILE-F)>

<OBJECT ARC (IN DISPATCH) (DESC "Blitz-Karte") (SYNONYM KARTE PROFIL BLITZ BLITZKARTE BLITZ-KARTE) (FLAGS NDESCBIT DIEBIT) (ACTION PROFILE-F)>

<OBJECT LENS (IN DISPATCH) (DESC "Luchs-Karte") (SYNONYM KARTE PROFIL LUCHS LUCHSKARTE LUCHS-KARTE) (FLAGS NDESCBIT DIEBIT) (ACTION PROFILE-F)>

<OBJECT DUTY-BOARD (IN DISPATCH) (DESC "Einsatztafel") (SYNONYM TAFEL EINSATZTAFEL BRETT) (FLAGS NDESCBIT DIEBIT) (ACTION DUTY-BOARD-F)>

<OBJECT WINDOW (IN DISPATCH) (DESC "Fenster") (SYNONYM FENSTER GLAS SCHEIBE) (FLAGS NDESCBIT DASBIT) (ACTION WINDOW-F)>

<OBJECT DOSSIER (DESC "Heldenbogen") (SYNONYM BOGEN HELDENBOGEN BLATT DOSSIER PAPIER) (FLAGS TAKEBIT READBIT DERBIT) (ACTION SHEET-F)>

<OBJECT TRAM (IN BRIDGE) (DESC "Straßenbahn") (SYNONYM BAHN STRASSENBAHN STRAßENBAHN WAGEN FAHRGAESTE FAHRG\%ASTE FAHRGAST PASSAGIERE PASSAGIER LEUTE MENSCHEN) (FLAGS NDESCBIT DIEBIT) (ACTION TRAM-F)>

<OBJECT CREW (IN BRIDGE) (DESC "Rettungsmannschaft") (SYNONYM MANNSCHAFT RETTUNGSMANNSCHAFT RETTER FEUERWEHR NETZ SPRUNGNETZ CHEFIN CHEF EINSATZLEITERIN) (FLAGS NDESCBIT ACTORBIT DIEBIT) (ACTION CREW-F)>

<OBJECT RAILS (IN BRIDGE) (DESC "Schiene") (SYNONYM SCHIENE SCHIENEN GLEIS GLEISE GELAENDER GEL\%ANDER) (FLAGS NDESCBIT DIEBIT) (ACTION RAILS-F)>

<OBJECT CABLE (IN BRIDGE) (DESC "Kabel") (SYNONYM KABEL KABELN DRAHT OBERLEITUNG SEIL) (FLAGS NDESCBIT DASBIT) (ACTION CABLE-F)>

<OBJECT DRONE (IN RELAY) (DESC "Wachdrohne") (SYNONYM DROHNE DROHNEN WACHDROHNE AUGE ROBOTER) (FLAGS NDESCBIT ACTORBIT DIEBIT) (ACTION DRONE-F)>

<OBJECT CONSOLE (IN RELAY) (DESC "Schaltpult") (SYNONYM PULT SCHALTPULT KONSOLE HEBEL BILDSCHIRM BILDSCHIRME SCHIRME) (FLAGS NDESCBIT DASBIT) (ACTION CONSOLE-F)>

<OBJECT SUPPLIES (IN RELAY) (DESC "Notfallkasten") (SYNONYM KASTEN NOTFALLKASTEN KIT KOFFER) (FLAGS NDESCBIT DERBIT) (ACTION KIT-F)>

;"Scenery the prose names in more than one room."
<OBJECT RAIN (IN LOCAL-GLOBALS) (DESC "Regen") (SYNONYM REGEN STURM GEWITTER) (FLAGS NDESCBIT DERBIT) (ACTION RAIN-F)>

<OBJECT CITY (IN LOCAL-GLOBALS) (DESC "Stadt") (SYNONYM STADT MERIDIAN HORIZONT STROM) (FLAGS NDESCBIT DIEBIT) (ACTION CITY-F)>

<OBJECT RIVER (IN LOCAL-GLOBALS) (DESC "Fluss") (SYNONYM FLUSS FLU\%SS STROEMUNG STR\%OMUNG WASSER) (FLAGS NDESCBIT DERBIT) (ACTION RIVER-F)>

<OBJECT BRIDGE-SPAN (IN LOCAL-GLOBALS) (DESC "Brücke") (SYNONYM BRUECKE BRüCKE) (FLAGS NDESCBIT DIEBIT) (ACTION BRIDGE-SPAN-F)>

<OBJECT DISTANT-TRAM (IN LOCAL-GLOBALS) (DESC "Straßenbahn") (SYNONYM BAHN STRASSENBAHN STRAßENBAHN WARNLICHT LICHT) (FLAGS NDESCBIT DIEBIT) (ACTION DISTANT-TRAM-F)>

<OBJECT STATION (IN LOCAL-GLOBALS) (DESC "Relaisstation") (SYNONYM STATION RELAISSTATION GEBAEUDE GEB\%AUDE HALLE) (FLAGS NDESCBIT DIEBIT) (ACTION STATION-F)>

<OBJECT STATION-DOOR (IN LOCAL-GLOBALS) (DESC "Stahltür") (SYNONYM TUER T\%UR STAHLTUER STAHLTüR TUERE T\%URE) (FLAGS NDESCBIT DIEBIT) (ACTION STATION-DOOR-F)>
