<GLOBAL ON-LOAN <>>
<GLOBAL PUBLISHED-LOAN <>>
<GLOBAL WIDE-LOAN <>>
<GLOBAL RECEIPT-READ <>>
<GLOBAL BOARD-READ <>>

<ROOM LENDING (DESC "Ausleihhalle") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
	(OST TO FOLDING) (NORD TO BASIN) (ACTION LENDING-F)>
<ROOM FOLDING (DESC "Faltraum") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
	(WEST TO LENDING) (NORD TO TERRACE) (ACTION FOLDING-F)>
<ROOM BASIN (DESC "Trockene Kammer") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
	(SUED TO LENDING) (OST TO TERRACE) (GLOBAL MARKET) (ACTION BASIN-F)>
<ROOM TERRACE (DESC "Leseterrasse") (IN ROOMS) (FLAGS RLANDBIT ONBIT)
	(SUED TO FOLDING) (WEST TO BASIN) (GLOBAL MARKET) (ACTION TERRACE-F)>

<OBJECT CASE (IN LENDING) (DESC "Leihschrank") (SYNONYM LEIHSCHRANK SCHRANK SCHILD T\%URSCHILD TUERSCHILD)
	(ADJECTIVE H\%OLZERN HOELZERN H\%OLZERNE HOELZERNE H\%OLZERNEN HOELZERNEN)
	(FLAGS NDESCBIT CONTBIT SEARCHBIT DERBIT READBIT) (CAPACITY 20)
	(ACTION CASE-F)>

<OBJECT LEAF (IN CASE) (DESC "Morgenblatt") (SYNONYM MORGENBLATT BLATT SEITE PAPIER)
	(ADJECTIVE KLEIN KLEINE KLEINES KLEINEN GOLDEN GOLDENE GOLDENES GOLDENEN BREIT BREITE BREITES)
	(FLAGS TAKEBIT READBIT TRYTAKEBIT DASBIT) (SIZE 5)
	(INTERACTIONS "PUT:CASE,BOARD,FRAME;PUT-ON:BOARD,FRAME") (ACTION LEAF-F)>

<OBJECT BOARD (IN FOLDING) (DESC "Faltbrett") (SYNONYM FALTBRETT BRETT TISCH KANTEN MITTE)
	(ADJECTIVE H\%OLZERN HOELZERN H\%OLZERNE HOELZERNE H\%OLZERNES HOELZERNES H\%OLZERNEN HOELZERNEN)
	(FLAGS NDESCBIT READBIT CONTBIT SEARCHBIT OPENBIT SURFACEBIT DASBIT) (CAPACITY 20)
	(ACTION BOARD-F)>

<OBJECT RECEIPT (IN BASIN) (DESC "Leihschein") (SYNONYM LEIHSCHEIN SCHEIN ZETTEL)
	(ADJECTIVE ALT ALTE ALTER ALTEN)
	(FLAGS NDESCBIT READBIT DERBIT) (ACTION RECEIPT-F)>

<OBJECT RILL (IN BASIN) (DESC "Steinrinne") (SYNONYM STEINRINNE RINNE WASSER BACH RINNSAL)
	(ADJECTIVE STEINERN STEINERNE TROCKEN TROCKENE TROCKENEN)
	(FLAGS NDESCBIT DIEBIT) (ACTION RILL-F)>

<OBJECT FRAME (IN TERRACE) (DESC "Leserahmen") (SYNONYM LESERAHMEN RAHMEN GESTELL)
	(ADJECTIVE LEER LEERE LEERER LEEREN)
	(FLAGS NDESCBIT CONTBIT SEARCHBIT OPENBIT READBIT SURFACEBIT DERBIT) (CAPACITY 20)
	(ACTION FRAME-F)>

<OBJECT STRIPES (IN LENDING) (DESC "Sonnenlicht") (SYNONYM SONNENLICHT LICHT LICHTSTREIFEN STREIFEN FENSTER SONNE)
	(ADJECTIVE GOLDEN GOLDENE GOLDENER SCHMAL SCHMALE SCHMALER BREIT BREITE BREITER)
	(FLAGS NDESCBIT DASBIT) (ACTION STRIPES-F)>

<OBJECT MARKET (IN LOCAL-GLOBALS) (DESC "Markt") (SYNONYM MARKT ST\%ANDE STAENDE PLATZ B\%ACKEREI BAECKEREI SCHATTEN LEUTE)
	(FLAGS NDESCBIT DERBIT) (ACTION MARKET-F)>

<OBJECT HALL-ROOM (IN LENDING) (DESC "Ausleihhalle") (SYNONYM AUSLEIHHALLE HALLE BIBLIOTHEK BODEN BRETTER BOGEN DURCHGANG REGALE)
	(FLAGS NDESCBIT DIEBIT) (ACTION HALL-ROOM-F)>

<OBJECT FOLDING-ROOM (IN FOLDING) (DESC "Faltraum") (SYNONYM FALTRAUM RAUM BOGEN TREPPE)
	(FLAGS NDESCBIT DERBIT) (ACTION FOLDING-ROOM-F)>

<OBJECT BASIN-ROOM (IN BASIN) (DESC "Steinkammer") (SYNONYM KAMMER STEINKAMMER WAND SPALT T\%UR TUER)
	(FLAGS NDESCBIT DIEBIT) (ACTION BASIN-ROOM-F)>

<OBJECT TERRACE-ROOM (IN TERRACE) (DESC "Balkon") (SYNONYM BALKON TERRASSE LESETERRASSE GEL\%ANDER GELAENDER D\%ACHER DAECHER TREPPE T\%UR TUER)
	(FLAGS NDESCBIT DERBIT) (ACTION TERRACE-ROOM-F)>
