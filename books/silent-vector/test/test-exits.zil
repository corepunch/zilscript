<INSERT-FILE "books/silent-vector/silent-vector">
<GLOBAL CO <CO-CREATE GO>>
<ROUTINE RUN-TEST ()
	<CO-RESUME ,CO "look" T>
	<SETG POWER T> <SETG PROOF T> <SETG ISOLATED T>
	<SETG HERE ,CRADLE> <MOVE ,WINNER ,CRADLE>
	<CO-RESUME ,CO "north" T>
	<ASSERT "CRADLE north HUB" <EQUAL? ,HERE ,HUB>>
	<CO-RESUME ,CO "south" T>
	<ASSERT "HUB south CRADLE" <EQUAL? ,HERE ,CRADLE>>
	<SETG HERE ,HUB> <MOVE ,WINNER ,HUB>
	<CO-RESUME ,CO "west" T>
	<ASSERT "HUB west WORKSHOP" <EQUAL? ,HERE ,WORKSHOP>>
	<CO-RESUME ,CO "east" T>
	<ASSERT "WORKSHOP east HUB" <EQUAL? ,HERE ,HUB>>
	<SETG HERE ,HUB> <MOVE ,WINNER ,HUB>
	<CO-RESUME ,CO "east" T>
	<ASSERT "HUB east GALLEY" <EQUAL? ,HERE ,GALLEY>>
	<CO-RESUME ,CO "west" T>
	<ASSERT "GALLEY west HUB" <EQUAL? ,HERE ,HUB>>
	<SETG HERE ,GALLEY> <MOVE ,WINNER ,GALLEY>
	<CO-RESUME ,CO "east" T>
	<ASSERT "GALLEY east RECORDS" <EQUAL? ,HERE ,RECORDS>>
	<CO-RESUME ,CO "west" T>
	<ASSERT "RECORDS west GALLEY" <EQUAL? ,HERE ,GALLEY>>
	<SETG HERE ,HUB> <MOVE ,WINNER ,HUB>
	<CO-RESUME ,CO "north" T>
	<ASSERT "HUB north CLINIC" <EQUAL? ,HERE ,CLINIC>>
	<CO-RESUME ,CO "south" T>
	<ASSERT "CLINIC south HUB" <EQUAL? ,HERE ,HUB>>
	<SETG HERE ,CLINIC> <MOVE ,WINNER ,CLINIC>
	<CO-RESUME ,CO "north" T>
	<ASSERT "CLINIC north LAB" <EQUAL? ,HERE ,LAB>>
	<CO-RESUME ,CO "south" T>
	<ASSERT "LAB south CLINIC" <EQUAL? ,HERE ,CLINIC>>
	<SETG HERE ,LAB> <MOVE ,WINNER ,LAB>
	<CO-RESUME ,CO "east" T>
	<ASSERT "LAB east QUARANTINE" <EQUAL? ,HERE ,QUARANTINE>>
	<CO-RESUME ,CO "west" T>
	<ASSERT "QUARANTINE west LAB" <EQUAL? ,HERE ,LAB>>
	<SETG HERE ,QUARANTINE> <MOVE ,WINNER ,QUARANTINE>
	<CO-RESUME ,CO "north" T>
	<ASSERT "QUARANTINE north CORE" <EQUAL? ,HERE ,CORE>>
	<CO-RESUME ,CO "south" T>
	<ASSERT "CORE south QUARANTINE" <EQUAL? ,HERE ,QUARANTINE>>
	<SETG HERE ,HUB> <MOVE ,WINNER ,HUB>
	<CO-RESUME ,CO "down" T>
	<ASSERT "HUB down SERVICE" <EQUAL? ,HERE ,SERVICE>>
	<CO-RESUME ,CO "up" T>
	<ASSERT "SERVICE up HUB" <EQUAL? ,HERE ,HUB>>
	<SETG HERE ,SERVICE> <MOVE ,WINNER ,SERVICE>
	<CO-RESUME ,CO "west" T>
	<ASSERT "SERVICE west COOLANT" <EQUAL? ,HERE ,COOLANT>>
	<CO-RESUME ,CO "east" T>
	<ASSERT "COOLANT east SERVICE" <EQUAL? ,HERE ,SERVICE>>
	<SETG HERE ,SERVICE> <MOVE ,WINNER ,SERVICE>
	<CO-RESUME ,CO "east" T>
	<ASSERT "SERVICE east RELAY" <EQUAL? ,HERE ,RELAY>>
	<CO-RESUME ,CO "west" T>
	<ASSERT "RELAY west SERVICE" <EQUAL? ,HERE ,SERVICE>>
	<SETG HERE ,RELAY> <MOVE ,WINNER ,RELAY>
	<CO-RESUME ,CO "north" T>
	<ASSERT "RELAY north RECEPTION" <EQUAL? ,HERE ,RECEPTION>>
	<CO-RESUME ,CO "south" T>
	<ASSERT "RECEPTION south RELAY" <EQUAL? ,HERE ,RELAY>>
	<SETG HERE ,HUB> <MOVE ,WINNER ,HUB>
	<CO-RESUME ,CO "up" T>
	<ASSERT "HUB up LAUNCH" <EQUAL? ,HERE ,LAUNCH>>
	<CO-RESUME ,CO "down" T>
	<ASSERT "LAUNCH down HUB" <EQUAL? ,HERE ,HUB>>
>
