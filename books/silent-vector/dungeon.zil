<DIRECTIONS NORTH EAST WEST SOUTH NE NW SE SW UP DOWN IN OUT LAND>
<ROOM CRADLE (IN ROOMS) (DESC "Restraint Cradle") (ACTION CRADLE-F)
	(LDESC "A dry click repeats through the padding. The [[breaker]] is within reach. The pressure-balanced way [[north]] leads into the habitat.")
	(NORTH PER CRADLE-NORTH) (FLAGS RLANDBIT ONBIT)>
<OBJECT BREAKER
	(INTERACTIONS "") (IN CRADLE) (DESC "habitat breaker") (SYNONYM BREAKER SWITCH RESET TELLTALE HOUSING PRESSURE) (ADJECTIVE HABITAT PRESSURE MECHANICAL)
	(FLAGS NDESCBIT) (ACTION BREAKER-F)>

<ROOM HUB (IN ROOMS) (DESC "Habitat Junction")
	(ACTION HUB-F)
	(SOUTH TO CRADLE)
	(WEST TO WORKSHOP)
	(EAST TO GALLEY)
	(NORTH TO CLINIC)
	(DOWN TO SERVICE)
	(UP TO LAUNCH)
	(FLAGS RLANDBIT ONBIT)>

<ROOM WORKSHOP (IN ROOMS) (DESC "Torque Shop")
	(LDESC "The air smells of warm insulation. A [[protocol card->protocol]] is fastened over the tool recesses. [[East]] returns to the junction.")
	(EAST TO HUB)
	(FLAGS RLANDBIT ONBIT)>

<ROOM GALLEY (IN ROOMS) (DESC "Galley")
	(ACTION GALLEY-F)
	(LDESC "The [[portrait]] turns slowly in the ventilation. [[Ivo]] is counting on his fingers, stopping at four, starting again. [[West]] returns to the junction; [[east]] leads to the physical archive.")
	(WEST TO HUB)
	(EAST TO RECORDS)
	(GLOBAL TOPIC-SIGNAL TOPIC-CREW TOPIC-DAUGHTER)
	(FLAGS RLANDBIT ONBIT)>

<ROOM RECORDS (IN ROOMS) (DESC "Physical Archive")
	(LDESC "Each footfall makes the [[recorder]] ring softly. A handwritten [[mass ledger->ledger]] is attached beside it. [[West]] returns to the galley.")
	(WEST TO GALLEY)
	(FLAGS RLANDBIT ONBIT)>

<ROOM CLINIC (IN ROOMS) (DESC "Clinic")
	(LDESC "The room smells of soap, a smell you have almost forgotten. A [[clinical log->log]] rests beside the examination area. [[South]] is the junction; [[north]] leads to the comparison laboratory.")
	(ACTION CLINIC-F)
	(SOUTH TO HUB)
	(NORTH TO LAB)
	(GLOBAL TOPIC-SIGNAL TOPIC-CREW TOPIC-DAUGHTER)
	(FLAGS RLANDBIT ONBIT)>

<ROOM LAB (IN ROOMS) (DESC "Comparison Laboratory")
	(LDESC "The [[comparator]] vibrates at the edge of hearing. [[South]] returns to the clinic; [[east]] leads to the screened quarantine room.")
	(ACTION LAB-F)
	(SOUTH TO CLINIC)
	(EAST TO QUARANTINE)
	(FLAGS RLANDBIT ONBIT)>

<ROOM SERVICE (IN ROOMS) (DESC "Service Spine")
	(LDESC "Warm air breathes through this narrow space. [[West]] leads to the coolant system, [[east]] to the receive relay. The junction is [[up]].")
	(WEST TO COOLANT)
	(EAST TO RELAY)
	(UP TO HUB)
	(FLAGS RLANDBIT ONBIT)>

<ROOM COOLANT (IN ROOMS) (DESC "Coolant Well")
	(LDESC "The [[pump]] makes a patient, unsuccessful sucking sound. The service spine is [[east]].")
	(ACTION COOLANT-F)
	(EAST TO SERVICE)
	(FLAGS RLANDBIT ONBIT)>

<ROOM RELAY (IN ROOMS) (DESC "Receive Relay")
	(ACTION RELAY-F)
	(WEST TO SERVICE)
	(NORTH TO RECEPTION)
	(FLAGS RLANDBIT ONBIT)>

<ROOM RECEPTION (IN ROOMS) (DESC "Receiver Vault")
	(ACTION RECEPTION-F)
	(SOUTH TO RELAY)
	(FLAGS RLANDBIT ONBIT)>

<ROOM QUARANTINE (IN ROOMS) (DESC "Screened Quarantine")
	(LDESC "[[Senn]] sits very upright, as if posture were a measurement. The comparison lab is [[west]]. The interlocked way [[north]] leads into the cold core.")
	(ACTION QUARANTINE-F)
	(WEST TO LAB)
	(NORTH PER CORE-NORTH)
	(GLOBAL TOPIC-SIGNAL TOPIC-CREW TOPIC-DAUGHTER)
	(FLAGS RLANDBIT ONBIT)>

<ROOM CORE (IN ROOMS) (DESC "Cold Core")
	(LDESC "Your breath hangs white above the [[cold archive->archive]]. The [[decision console->console]] has two recessed commitments. Quarantine is [[south]].")
	(ACTION CORE-F)
	(SOUTH TO QUARANTINE)
	(FLAGS RLANDBIT ONBIT)>

<ROOM LAUNCH (IN ROOMS) (DESC "Launch Cupola")
	(LDESC "The stars do not flicker here. The mechanical [[beacon]] points away from the station. The habitat junction is [[down]].")
	(ACTION LAUNCH-F)
	(DOWN TO HUB)
	(GLOBAL TOPIC-SIGNAL TOPIC-CREW TOPIC-DAUGHTER)
	(FLAGS RLANDBIT ONBIT)>

<OBJECT WRENCH
	(INTERACTIONS "PUT:COLD-ARCHIVE") (IN WORKSHOP) (DESC "torque wrench")
	(SYNONYM WRENCH DRIVER GRIP) (ADJECTIVE TORQUE)
	(FLAGS TAKEBIT TOOLBIT) (ACTION WRENCH-F)
	(LDESC "A [[torque wrench->wrench]] rests in its recess.")>

<OBJECT SPOOL
	(INTERACTIONS "FIT:BUS;PUT:BUS") (IN WORKSHOP) (DESC "null spool")
	(SYNONYM SPOOL TERMINATOR) (ADJECTIVE NULL)
	(FLAGS TAKEBIT) (ACTION SPOOL-F)
	(LDESC "A [[null spool->spool]] sits in a shaped recess.")>

<OBJECT SHEARS
	(INTERACTIONS "") (IN CLINIC) (DESC "pair of ceramic shears")
	(SYNONYM SHEARS CUTTER BLADES EDGES PAIR) (ADJECTIVE CERAMIC)
	(FLAGS TAKEBIT TOOLBIT WEAPONBIT) (ACTION SHEARS-F)
	(LDESC "A pair of [[ceramic shears->shears]] lies ready for sterile work.")>

<OBJECT PROTOCOL
	(INTERACTIONS "") (IN WORKSHOP) (DESC "protocol card")
	(SYNONYM PROTOCOL CARD INSTRUCTIONS)
	(FLAGS NDESCBIT READBIT) (ACTION PROTOCOL-F)>

<OBJECT PORTRAIT
	(INTERACTIONS "") (IN GALLEY) (DESC "droplet portrait")
	(SYNONYM PORTRAIT PICTURE DROPLETS) (ADJECTIVE DROPLET FAMILY)
	(FLAGS NDESCBIT) (ACTION PORTRAIT-F)>

<OBJECT RECORDER
	(INTERACTIONS "") (IN RECORDS) (DESC "witness recorder")
	(SYNONYM RECORDER DRUM LID) (ADJECTIVE WITNESS PHYSICAL)
	(FLAGS NDESCBIT CONTBIT SEARCHBIT) (ACTION RECORDER-F)
	(CAPACITY 30)>

<OBJECT STRIP
	(INTERACTIONS "COMPARE:COMPARATOR,PUMP;SHOW:MARA,IVO,SENN;PUT:RECORDER,COLD-ARCHIVE") (IN RECORDER) (DESC "witness strip")
	(SYNONYM STRIP FOIL REFERENCE TRACE TRACES HANDSTAMP) (ADJECTIVE WITNESS PHYSICAL)
	(FLAGS TAKEBIT READBIT) (ACTION STRIP-F)
	(LDESC "A [[witness strip->strip]] lies here.")>

<OBJECT LEDGER
	(INTERACTIONS "") (IN RECORDS) (DESC "mass ledger")
	(SYNONYM LEDGER MANIFEST) (ADJECTIVE MASS HANDWRITTEN)
	(FLAGS NDESCBIT READBIT) (ACTION LEDGER-F)>

<OBJECT LOG
	(INTERACTIONS "") (IN CLINIC) (DESC "clinical log")
	(SYNONYM LOG CHART) (ADJECTIVE CLINICAL MEDICAL)
	(FLAGS NDESCBIT READBIT) (ACTION LOG-F)>

<OBJECT COMPARATOR
	(INTERACTIONS "COMPARE:STRIP,WRENCH") (IN LAB) (DESC "optical comparator")
	(SYNONYM COMPARATOR READER INSTRUMENT) (ADJECTIVE OPTICAL)
	(FLAGS NDESCBIT) (ACTION COMPARATOR-F)>

<OBJECT PUMP
	(INTERACTIONS "TURN:WRENCH,SHEARS") (IN COOLANT) (DESC "coolant pump")
	(SYNONYM PUMP FITTING) (ADJECTIVE COOLANT TORQUE)
	(FLAGS NDESCBIT TURNBIT) (ACTION PUMP-F)>

<OBJECT BUS
	(INTERACTIONS "FIT:SPOOL,WRENCH;CUT:SHEARS,WRENCH;PUT:SPOOL") (IN RELAY) (DESC "incoming bus")
	(SYNONYM BUS LINE CIRCUIT SOCKET CONTACTS) (ADJECTIVE INCOMING)
	(FLAGS NDESCBIT CONTBIT OPENBIT SEARCHBIT) (ACTION BUS-F)
	(CAPACITY 10)>

<OBJECT RECEIVER
	(INTERACTIONS "") (IN RECEPTION) (DESC "signal receiver")
	(SYNONYM RECEIVER HOUSING) (ADJECTIVE SIGNAL)
	(FLAGS NDESCBIT CONTBIT SEARCHBIT) (ACTION RECEIVER-F)
	(CAPACITY 30)>

<OBJECT WAFER
	(INTERACTIONS "PUT:COLD-ARCHIVE,RECEIVER;SHOW:MARA,IVO,SENN") (IN RECEIVER) (DESC "memory wafer")
	(SYNONYM WAFER SAMPLE MEMORY INDEX DOMAINS) (ADJECTIVE MEMORY)
	(FLAGS TAKEBIT) (ACTION WAFER-F)
	(LDESC "A [[memory wafer->wafer]] lies here.")>

<OBJECT COLD-ARCHIVE
	(INTERACTIONS "") (IN CORE) (DESC "cold archive")
	(SYNONYM ARCHIVE DEGAUSSER CHAMBER FROST SLEEVE) (ADJECTIVE COLD)
	(FLAGS NDESCBIT CONTBIT OPENBIT SEARCHBIT) (ACTION ARCHIVE-F)
	(CAPACITY 30)>

<OBJECT CONSOLE
	(INTERACTIONS "") (IN CORE) (DESC "decision console")
	(SYNONYM CONSOLE COMMITMENTS) (ADJECTIVE DECISION)
	(FLAGS NDESCBIT) (ACTION CONSOLE-F)>

<OBJECT BEACON
	(INTERACTIONS "") (IN LAUNCH) (DESC "rendezvous beacon")
	(SYNONYM BEACON LAUNCHER) (ADJECTIVE MECHANICAL RENDEZVOUS)
	(FLAGS NDESCBIT) (ACTION BEACON-F)>

<OBJECT MARA
	(INTERACTIONS "TELL:TOPIC-SIGNAL,TOPIC-CREW,TOPIC-DAUGHTER,WAFER;SHOW:STRIP,WAFER") (IN CLINIC) (DESC "Mara Vale")
	(SYNONYM MARA VALE DOCTOR PHYSICIAN) (ADJECTIVE DOCTOR)
	(FLAGS NDESCBIT ACTORBIT) (ACTION MARA-F)>

<OBJECT IVO
	(INTERACTIONS "TELL:TOPIC-SIGNAL,TOPIC-CREW,TOPIC-DAUGHTER,WAFER;SHOW:STRIP,WAFER") (IN GALLEY) (DESC "Ivo Chen")
	(SYNONYM IVO CHEN OPERATOR) (ADJECTIVE OPERATOR)
	(FLAGS NDESCBIT ACTORBIT) (ACTION IVO-F)>

<OBJECT SENN
	(INTERACTIONS "TELL:TOPIC-SIGNAL,TOPIC-CREW,TOPIC-DAUGHTER,WAFER;SHOW:STRIP,WAFER") (IN QUARANTINE) (DESC "Senn Orlov")
	(SYNONYM SENN ORLOV RESEARCHER) (ADJECTIVE RESEARCHER)
	(FLAGS NDESCBIT ACTORBIT) (ACTION SENN-F)>

<OBJECT TOPIC-SIGNAL
	(INTERACTIONS "") (IN LOCAL-GLOBALS) (DESC "signal")
	(SYNONYM SIGNAL TRANSMISSION CARRIER) (ADJECTIVE RECEIVED)
	(FLAGS NDESCBIT) (ACTION TOPIC-F)>

<OBJECT TOPIC-CREW
	(INTERACTIONS "") (IN LOCAL-GLOBALS) (DESC "crew")
	(SYNONYM CREW PEOPLE PERSON FIFTH) (ADJECTIVE PHYSICAL)
	(FLAGS NDESCBIT) (ACTION TOPIC-F)>

<OBJECT TOPIC-DAUGHTER
	(INTERACTIONS "") (IN LOCAL-GLOBALS) (DESC "daughter")
	(SYNONYM DAUGHTER LENA CHILD) (ADJECTIVE MISSING)
	(FLAGS NDESCBIT) (ACTION TOPIC-F)>

<OBJECT CRADLE-FRAME
	(INTERACTIONS "") (IN CRADLE) (DESC "restraint frame")
	(SYNONYM FRAME CRADLE RESTRAINT GRIPS PADDING DOOR INTERLOCK)
	(ADJECTIVE RESTRAINT PRESSURE) (FLAGS NDESCBIT DOORBIT) (ACTION FRAME-F)>
<OBJECT RECESSES
	(INTERACTIONS "") (IN WORKSHOP) (DESC "tool recesses")
	(SYNONYM RECESSES RECESS INSULATION) (ADJECTIVE TOOL) (FLAGS NDESCBIT) (ACTION RECESSES-F)>
<OBJECT EXAM-AREA
	(INTERACTIONS "") (IN CLINIC) (DESC "examination area")
	(SYNONYM AREA BED SOAP) (ADJECTIVE EXAMINATION) (FLAGS NDESCBIT) (ACTION EXAM-AREA-F)>
<OBJECT STARFIELD
	(INTERACTIONS "") (IN LAUNCH) (DESC "distant stars")
	(SYNONYM STARS STARFIELD SPACE) (ADJECTIVE DISTANT) (FLAGS NDESCBIT) (ACTION STARFIELD-F)>
<OBJECT LAUNCH-HARDWARE
	(INTERACTIONS "") (IN LAUNCH) (DESC "evacuation restraints")
	(SYNONYM RESTRAINTS RESTRAINT REFLECTOR CUPOLA) (ADJECTIVE EVACUATION PHYSICAL)
	(FLAGS NDESCBIT) (ACTION HARDWARE-F)>
