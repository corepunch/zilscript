<DIRECTIONS NORTH EAST WEST SOUTH NE NW SE SW UP DOWN IN OUT LAND>
<ROOM CRADLE (IN ROOMS) (DESC "Restraint Cradle") (ACTION CRADLE-F)
	(NORTH PER CRADLE-NORTH) (FLAGS RLANDBIT ONBIT)>
<OBJECT BREAKER
	(INTERACTIONS "") (IN CRADLE) (DESC "habitat breaker") (SYNONYM BREAKER SWITCH RESET HOUSING PRESSURE) (ADJECTIVE HABITAT PRESSURE MECHANICAL TRIPPED BROAD)
	(FLAGS NDESCBIT) (ACTION BREAKER-F)>

<ROOM HUB (IN ROOMS) (DESC "Habitat Junction")
	(ACTION HUB-F)
	(GLOBAL LADDER)
	(SOUTH TO CRADLE)
	(WEST TO WORKSHOP)
	(EAST TO GALLEY)
	(NORTH TO CLINIC)
	(DOWN TO SERVICE)
	(UP TO LAUNCH)
	(FLAGS RLANDBIT ONBIT)>

<ROOM WORKSHOP (IN ROOMS) (DESC "Torque Shop")
	(LDESC "You are in the Torque Shop, where the station's hand tools are kept. The walls are covered in warm insulation, and shaped tool recesses are cut into it below a laminated protocol card. Everything smells faintly of machine oil. The only way out is east, back to the junction.")
	(EAST TO HUB)
	(FLAGS RLANDBIT ONBIT)>

<ROOM GALLEY (IN ROOMS) (DESC "Galley")
	(ACTION GALLEY-F)
	(WEST TO HUB)
	(EAST TO RECORDS)
	(GLOBAL TOPIC-SIGNAL TOPIC-CREW TOPIC-DAUGHTER)
	(FLAGS RLANDBIT ONBIT)>

<ROOM RECORDS (IN ROOMS) (ACTION RECORDS-LOOK) (DESC "Physical Archive")
	(WEST TO GALLEY)
	(FLAGS RLANDBIT ONBIT)>

<ROOM CLINIC (IN ROOMS) (DESC "Clinic")
	(ACTION CLINIC-F)
	(SOUTH TO HUB)
	(NORTH TO LAB)
	(GLOBAL TOPIC-SIGNAL TOPIC-CREW TOPIC-DAUGHTER)
	(FLAGS RLANDBIT ONBIT)>

<ROOM LAB (IN ROOMS) (DESC "Comparison Laboratory")
	(ACTION LAB-F)
	(SOUTH TO CLINIC)
	(EAST TO QUARANTINE)
	(FLAGS RLANDBIT ONBIT)>

<ROOM SERVICE (IN ROOMS) (DESC "Service Spine")
	(LDESC "You are in the Service Spine, a cramped crawlway of pipes and cable trays beneath the habitat. A steady draught rattles a ventilation grille, and the pipes tick softly overhead. To the west lies the coolant well, and the receive relay is to the east. A ladder climbs up to the junction.")
	(WEST TO COOLANT)
	(EAST TO RELAY)
	(UP TO HUB)
	(GLOBAL LADDER SPINE-PIPES)
	(FLAGS RLANDBIT ONBIT)>

<ROOM COOLANT (IN ROOMS) (DESC "Coolant Well")
	(ACTION COOLANT-F)
	(EAST TO SERVICE)
	(GLOBAL SPINE-PIPES)
	(FLAGS RLANDBIT ONBIT)>

<ROOM RELAY (IN ROOMS) (DESC "Receive Relay")
	(ACTION RELAY-F)
	(WEST TO SERVICE)
	(NORTH TO RECEPTION)
	(FLAGS RLANDBIT ONBIT)>

<ROOM RECEPTION (IN ROOMS) (DESC "Receiver Vault")
	(ACTION RECEPTION-F)
	(SOUTH TO RELAY)
	(FLAGS RLANDBIT ONBIT)>

<ROOM QUARANTINE (IN ROOMS) (DESC "Screened Quarantine")
	(ACTION QUARANTINE-F)
	(WEST TO LAB)
	(NORTH PER CORE-NORTH)
	(GLOBAL TOPIC-SIGNAL TOPIC-CREW TOPIC-DAUGHTER)
	(FLAGS RLANDBIT ONBIT)>

<ROOM CORE (IN ROOMS) (DESC "Cold Core")
	(ACTION CORE-F)
	(SOUTH TO QUARANTINE)
	(FLAGS RLANDBIT ONBIT)>

<ROOM LAUNCH (IN ROOMS) (DESC "Launch Cupola")
	(ACTION LAUNCH-F)
	(DOWN TO HUB)
	(GLOBAL TOPIC-SIGNAL TOPIC-CREW TOPIC-DAUGHTER LADDER)
	(FLAGS RLANDBIT ONBIT)>

<OBJECT COPPER-STRIP
	(IN HUB) (DESC "copper strip")
	(SYNONYM RAIL COPPER STRIP MARK MARKS) (ADJECTIVE COPPER BARE WORN FOUR FINGER)
	(INTERACTIONS "") (FLAGS NDESCBIT)
	(ACTION COPPER-STRIP-F)>

<OBJECT WRENCH
	(INTERACTIONS "PUT:COLD-ARCHIVE") (IN WORKSHOP) (DESC "torque wrench")
	(SYNONYM WRENCH DRIVER GRIP SPANNER) (ADJECTIVE TORQUE CALIBRATED WORN SQUARE)
	(FLAGS NDESCBIT TAKEBIT TOOLBIT) (ACTION WRENCH-F)
	(LDESC "A torque wrench lies here.")>

<OBJECT SPOOL
	(INTERACTIONS "FIT:BUS;PUT:BUS") (IN WORKSHOP) (DESC "null spool")
	(SYNONYM SPOOL TERMINATOR) (ADJECTIVE NULL PASSIVE MATCHED)
	(FLAGS NDESCBIT TAKEBIT) (ACTION SPOOL-F)
	(LDESC "A null spool lies here.")>

<OBJECT SPINE-GRILLE
	(IN SERVICE) (DESC "ventilation grille")
	(SYNONYM GRILLE VENT GRATE DRAUGHT DRAFT) (ADJECTIVE VENTILATION METAL)
	(INTERACTIONS "") (FLAGS NDESCBIT)
	(TEXT "One screw has shaken loose. A narrow strip of foil tied to the grille lifts in the draught toward the habitat above.")
	(ACTION GRILLE-F)>

<OBJECT SHEARS
	(INTERACTIONS "") (IN CLINIC) (DESC "pair of ceramic shears")
	(SYNONYM SHEARS CUTTER BLADES EDGES PAIR SHEAR SCISSORS) (ADJECTIVE CERAMIC NONCONDUCTIVE STERILE)
	(FLAGS NDESCBIT TAKEBIT TOOLBIT WEAPONBIT) (ACTION SHEARS-F)
	(LDESC "A pair of ceramic shears lies here.")>

<OBJECT PROTOCOL
	(INTERACTIONS "") (IN WORKSHOP) (DESC "protocol card")
	(SYNONYM CARD PROTOCOL INSTRUCTIONS PROCEDURE)
	(ADJECTIVE PROTOCOL ISOLATION)
	(FLAGS NDESCBIT READBIT) (ACTION PROTOCOL-F)>

<OBJECT PORTRAIT
	(INTERACTIONS "") (IN GALLEY) (DESC "droplet portrait")
	(SYNONYM PORTRAIT PICTURE PHOTOGRAPH PHOTO FIELD) (ADJECTIVE DROPLET FAMILY CLEAR CHILD)
	(FLAGS NDESCBIT) (ACTION PORTRAIT-F)>

<OBJECT RECORDER
	(INTERACTIONS "") (IN RECORDS) (DESC "witness recorder")
	(SYNONYM RECORDER DRUM LID FOOTFALL FOOTSTEPS FEET) (ADJECTIVE WITNESS PHYSICAL SEALED MECHANICAL DISCONNECTED EXPOSED)
	(FLAGS NDESCBIT CONTBIT SEARCHBIT) (ACTION RECORDER-F)
	(CAPACITY 30)>

<OBJECT STRIP
	(INTERACTIONS "COMPARE:COMPARATOR,PUMP;SHOW:MARA,IVO,SENN;PUT:RECORDER,COLD-ARCHIVE") (IN RECORDER) (DESC "witness strip")
	(SYNONYM STRIP FOIL REFERENCE TRACE TRACES HANDSTAMP) (ADJECTIVE WITNESS PHYSICAL FOIL MEASURED ORIGINAL OPTICAL)
	(FLAGS TAKEBIT READBIT) (ACTION STRIP-F)
	(LDESC "A witness strip lies here.")>

<OBJECT LEDGER
	(INTERACTIONS "") (IN RECORDS) (DESC "mass ledger")
	(SYNONYM LEDGER MANIFEST BOOK) (ADJECTIVE MASS HANDWRITTEN INDENTED DEPARTURE)
	(FLAGS NDESCBIT READBIT) (ACTION LEDGER-F)>

<OBJECT LOG
	(INTERACTIONS "") (IN CLINIC) (DESC "clinical log")
	(SYNONYM LOG CHART RECORD) (ADJECTIVE CLINICAL MEDICAL)
	(FLAGS NDESCBIT READBIT) (ACTION LOG-F)>

<OBJECT COMPARATOR
	(INTERACTIONS "COMPARE:STRIP,WRENCH") (IN LAB) (DESC "optical comparator")
	(SYNONYM COMPARATOR READER INSTRUMENT READOUT DISPLAY) (ADJECTIVE OPTICAL INDEPENDENT PHYSICAL LABORATORY)
	(FLAGS NDESCBIT) (ACTION COMPARATOR-F)>

<OBJECT PUMP
	(INTERACTIONS "TURN:WRENCH,SHEARS") (IN COOLANT) (DESC "coolant pump")
	(SYNONYM PUMP FITTING MIST COOLANT) (ADJECTIVE COOLANT TORQUE SQUARE LOOSE SEALED COLD)
	(FLAGS NDESCBIT TURNBIT) (ACTION PUMP-F)>

<OBJECT BUS
	(INTERACTIONS "FIT:SPOOL,WRENCH;CUT:SHEARS,WRENCH;PUT:SPOOL") (IN RELAY) (DESC "incoming bus")
	(SYNONYM BUS LINE CIRCUIT SOCKET CONTACTS CABLE) (ADJECTIVE INCOMING LIVE SEVERED TERMINATED EXPOSED)
	(FLAGS NDESCBIT CONTBIT OPENBIT SEARCHBIT) (ACTION BUS-F)
	(CAPACITY 10)>

<OBJECT RECEIVER
	(INTERACTIONS "") (IN RECEPTION) (DESC "signal receiver")
	(SYNONYM RECEIVER HOUSING VAULT) (ADJECTIVE SIGNAL LIVE DEAD MECHANICAL ISOLATED)
	(FLAGS NDESCBIT CONTBIT SEARCHBIT) (ACTION RECEIVER-F)
	(CAPACITY 30)>

<OBJECT WAFER
	(INTERACTIONS "PUT:COLD-ARCHIVE,RECEIVER;SHOW:MARA,IVO,SENN") (IN RECEIVER) (DESC "memory wafer")
	(SYNONYM WAFER SAMPLE MEMORY DOMAINS SPECIMEN) (ADJECTIVE MEMORY PASSIVE UNPOWERED ENGRAVED)
	(FLAGS TAKEBIT OPENBIT SEARCHBIT) (ACTION WAFER-F)
	(LDESC "A memory wafer lies here.")>

<OBJECT COLD-ARCHIVE
	(INTERACTIONS "") (IN CORE) (DESC "cold archive")
	(SYNONYM ARCHIVE DEGAUSSER CHAMBER FROST SLEEVE) (ADJECTIVE COLD COOLED WARM EMPTY ACCESS)
	(FLAGS NDESCBIT CONTBIT OPENBIT SEARCHBIT) (ACTION ARCHIVE-F)
	(CAPACITY 30)>

<OBJECT CONSOLE
	(INTERACTIONS "") (IN CORE) (DESC "decision console")
	(SYNONYM CONSOLE COMMITMENTS PANEL) (ADJECTIVE DECISION FINAL COLD-CORE)
	(FLAGS NDESCBIT) (ACTION CONSOLE-F)>

<OBJECT BEACON
	(INTERACTIONS "") (IN LAUNCH) (DESC "rendezvous beacon")
	(SYNONYM BEACON LAUNCHER REFLECTOR) (ADJECTIVE MECHANICAL RENDEZVOUS PASSIVE BALLISTIC ARMED STORAGE)
	(FLAGS NDESCBIT) (ACTION BEACON-F)>

<OBJECT MARA
	(INTERACTIONS "TELL:TOPIC-SIGNAL,TOPIC-CREW,TOPIC-DAUGHTER,WAFER;SHOW:STRIP,WAFER") (IN CLINIC) (DESC "Mara Vale")
	(SYNONYM MARA VALE DOCTOR PHYSICIAN) (ADJECTIVE DOCTOR DR)
	(FLAGS NDESCBIT ACTORBIT) (ACTION MARA-F)>

<OBJECT IVO
	(INTERACTIONS "TELL:TOPIC-SIGNAL,TOPIC-CREW,TOPIC-DAUGHTER,WAFER;SHOW:STRIP,WAFER") (IN GALLEY) (DESC "Ivo Chen")
	(SYNONYM IVO CHEN OPERATOR) (ADJECTIVE OPERATOR)
	(FLAGS NDESCBIT ACTORBIT) (ACTION IVO-F)>

<OBJECT SENN
	(INTERACTIONS "TELL:TOPIC-SIGNAL,TOPIC-CREW,TOPIC-DAUGHTER,WAFER;SHOW:STRIP,WAFER") (IN QUARANTINE) (DESC "Senn Orlov")
	(SYNONYM SENN ORLOV RESEARCHER SCIENTIST) (ADJECTIVE RESEARCHER)
	(FLAGS NDESCBIT ACTORBIT) (ACTION SENN-F)>

<OBJECT TOPIC-SIGNAL
	(INTERACTIONS "") (IN LOCAL-GLOBALS) (DESC "signal")
	(SYNONYM SIGNAL TRANSMISSION CARRIER) (ADJECTIVE RECEIVED RESCUE)
	(FLAGS NDESCBIT) (ACTION TOPIC-F)>

<OBJECT TOPIC-CREW
	(INTERACTIONS "") (IN LOCAL-GLOBALS) (DESC "crew")
	(SYNONYM CREW PEOPLE PERSON FIFTH PASSENGERS) (ADJECTIVE PHYSICAL LIVING)
	(FLAGS NDESCBIT) (ACTION TOPIC-F)>

<OBJECT TOPIC-DAUGHTER
	(INTERACTIONS "") (IN LOCAL-GLOBALS) (DESC "daughter")
	(SYNONYM DAUGHTER LENA CHILD) (ADJECTIVE MISSING SENN LOST)
	(FLAGS NDESCBIT) (ACTION TOPIC-F)>

<OBJECT CRADLE-FRAME
	(INTERACTIONS "") (IN CRADLE) (DESC "restraint frame")
	(SYNONYM FRAME CRADLE RESTRAINT GRIPS PADDING DOOR INTERLOCK DOORWAY CLICK NICHE)
	(ADJECTIVE RESTRAINT PRESSURE MECHANICAL WORN DRY) (FLAGS NDESCBIT DOORBIT) (ACTION FRAME-F)>
<OBJECT RECESSES
	(INTERACTIONS "") (IN WORKSHOP) (DESC "tool recesses")
	(SYNONYM RECESSES RECESS INSULATION SLOTS SLOT TOOLS WALLS WALL) (ADJECTIVE TOOL SHAPED EMPTY) (FLAGS NDESCBIT PLURALBIT) (ACTION RECESSES-F)>
<OBJECT EXAM-AREA
	(INTERACTIONS "") (IN CLINIC) (DESC "exam bed")
	(SYNONYM BED AREA SOAP LAMP SHEET) (ADJECTIVE EXAM CLINIC MEDICAL CLEAN WHITE) (FLAGS NDESCBIT) (ACTION EXAM-AREA-F)>
<OBJECT STARFIELD
	(INTERACTIONS "") (IN LAUNCH) (DESC "distant stars")
	(SYNONYM STARS STARFIELD SPACE STAR DOME GLASS) (ADJECTIVE DISTANT) (FLAGS NDESCBIT PLURALBIT) (ACTION STARFIELD-F)>
<OBJECT LAUNCH-HARDWARE
	(INTERACTIONS "") (IN LAUNCH) (DESC "evacuation restraints")
	(SYNONYM RESTRAINTS RESTRAINT CUPOLA PLACES SEATS SEAT) (ADJECTIVE EVACUATION PHYSICAL PASSIVE FOUR EMPTY)
	(FLAGS NDESCBIT PLURALBIT) (ACTION HARDWARE-F)>

<OBJECT CORE-INTERLOCK (IN QUARANTINE) (DESC "core interlock")
    (SYNONYM INTERLOCK SEAL DOOR) (ADJECTIVE CORE PRESSURE)
    (FLAGS NDESCBIT) (INTERACTIONS "")
    (ACTION CORE-INTERLOCK-F)>

<OBJECT DETAIL-BUCKLE (IN CRADLE) (DESC "buckle")
    (SYNONYM BUCKLE CLASP RELEASE TONGUE) (ADJECTIVE RESTRAINT METAL POLISHED)
    (FLAGS NDESCBIT) (INTERACTIONS "")
    (ACTION DETAIL-BUCKLE-F)>

<OBJECT DETAIL-STRIP-OF-FOIL (IN SERVICE) (DESC "foil streamer")
    (SYNONYM FOIL STREAMER) (ADJECTIVE NARROW FOIL)
    (FLAGS NDESCBIT) (INTERACTIONS "")
    (TEXT "One end is folded twice around the grille. The free end points uphill even when you hold your breath.")>

<OBJECT DETAIL-DROPLETS (IN GALLEY) (DESC "droplets")
    (SYNONYM DROPLETS DROPS) (ADJECTIVE CLEAR)
    (FLAGS NDESCBIT PLURALBIT) (INTERACTIONS "")
    (TEXT "Shift your head a little. A cheek breaks up into separate beads and then comes together again when you lean back.")
	(ACTION DROPLETS-F)>

<OBJECT DETAIL-INSPECTION-FLAGS (IN QUARANTINE) (DESC "interlock flags")
    (SYNONYM FLAGS FLAG TABS INSPECTION) (ADJECTIVE INTERLOCK TWO BOLT)
    (FLAGS NDESCBIT PLURALBIT) (INTERACTIONS "")
    (ACTION FLAGS-DETAIL-F)>

<OBJECT DETAIL-TELLTALE (IN CRADLE) (DESC "telltale")
    (SYNONYM TELLTALE NEEDLE GAUGE) (ADJECTIVE MECHANICAL PRESSURE)
    (FLAGS NDESCBIT) (INTERACTIONS "")
    (ACTION GAUGE-DETAIL-F)>

<OBJECT WAFER-CLIPS (IN RECEIVER) (DESC "spring clips")
    (SYNONYM CLIPS CLIP JAWS) (ADJECTIVE SPRING METAL)
    (SIZE 0) (FLAGS NDESCBIT PLURALBIT) (INTERACTIONS "")
    (ACTION WAFER-CLIPS-F)>

<OBJECT ENGRAVED-INDEX (IN WAFER) (DESC "engraved index")
    (SYNONYM INDEX INSCRIPTION LETTERING) (ADJECTIVE ENGRAVED)
    (SIZE 0) (FLAGS NDESCBIT READBIT) (INTERACTIONS "")
    (ACTION INDEX-DETAIL-F)>

<OBJECT RETURN-STAMP (IN WAFER) (DESC "return stamp")
    (SYNONYM STAMP SERIAL OVERPRINT) (ADJECTIVE RETURN OUTER-RELAY)
    (SIZE 0) (FLAGS NDESCBIT READBIT) (INTERACTIONS "")
    (TEXT "At the crossing, the raised edge of the serial is flattened. The relay stamp was put on second.")
    (ACTION RETURN-STAMP-F)>

<OBJECT JUNCTION (IN HUB) (DESC "junction")
	(SYNONYM JUNCTION HUB WALL WALLS STATION HATCHES) (ADJECTIVE HABITAT SIX-WAY PADDED)
	(FLAGS NDESCBIT) (INTERACTIONS "")
	(TEXT "Six hatches open off the round junction, each stencilled with a name worn soft by hands: shop, galley, clinic, cradle, spine, cupola. The walls between them are padded.")
	(ACTION JUNCTION-F)>

<OBJECT LADDER (IN LOCAL-GLOBALS) (DESC "ladder")
	(SYNONYM LADDER RUNGS RUNG) (ADJECTIVE STEEL)
	(FLAGS NDESCBIT) (INTERACTIONS "")
	(TEXT "A steel ladder runs through the junction, from the service spine below to the launch cupola above.")
	(ACTION LADDER-F)>

<OBJECT GALLEY-TABLE (IN GALLEY) (DESC "galley table")
	(SYNONYM TABLE RICE COFFEE MUGS MUG TRAYS) (ADJECTIVE GALLEY BOLTED SINGLE COLD)
	(FLAGS NDESCBIT) (INTERACTIONS "")
	(TEXT "A single table bolted to the deck, with four mugs clipped to its rim and the remains of a meal nobody finished.")
	(ACTION GALLEY-TABLE-F)>

<OBJECT SHELVES (IN RECORDS) (DESC "paper shelves")
	(SYNONYM SHELVES SHELF STOREROOM CASES) (ADJECTIVE PAPER SEALED)
	(FLAGS NDESCBIT PLURALBIT) (INTERACTIONS "")
	(TEXT "Sealed cases of paper records line the shelves, each labelled by year. They are the station's memory, written down where nothing can rewrite it.")
	(ACTION SHELVES-F)>

<OBJECT BENCHES (IN LAB) (DESC "steel benches")
	(SYNONYM BENCHES BENCH) (ADJECTIVE STEEL LABORATORY)
	(FLAGS NDESCBIT PLURALBIT) (INTERACTIONS "")
	(TEXT "Long steel benches, bare except for the instruments bolted to them. Everything here is built to measure, not to listen.")
	(ACTION BENCHES-F)>

<OBJECT SPINE-PIPES (IN LOCAL-GLOBALS) (DESC "pipes")
	(SYNONYM PIPES PIPE TRAYS CRAWLWAY SHAFT LOOP DECK) (ADJECTIVE COOLANT COOLING CABLE)
	(FLAGS NDESCBIT PLURALBIT) (INTERACTIONS "")
	(TEXT "Insulated coolant pipes and cable trays run the length of the station's underside, close enough to touch.")
	(ACTION PIPES-F)>

<OBJECT RELAY-BAY (IN RELAY) (DESC "relay bay")
	(SYNONYM BAY CONDUIT ANTENNAS) (ADJECTIVE RELAY NARROW)
	(FLAGS NDESCBIT) (INTERACTIONS "")
	(TEXT "A narrow bay of grey panels. The only thing in it that matters is the cable coming out of its conduit.")
	(ACTION BAY-F)>

<OBJECT SHIELDING (IN QUARANTINE) (DESC "shielding")
	(SYNONYM SHIELDING CELL WALLS WALL BENCH) (ADJECTIVE GREY DULL HEAVY)
	(FLAGS NDESCBIT) (INTERACTIONS "")
	(TEXT "Heavy grey shielding hangs on every wall, seamed like quilting. The only furniture is a single steel bench.")
	(ACTION SHIELDING-F)>
