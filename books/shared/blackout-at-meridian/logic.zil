; "Blackout at Meridian: the story's rooms, objects, state and actions, with no
  words. Each edition (en.zil, de.zil) declares the same rooms and objects
  again with its words and defines every MSG-* routine this file calls."
<GLOBAL HERO-CLASS 0>
<GLOBAL RESCUED <>>
<GLOBAL DISABLED <>>
<GLOBAL BOOSTED <>>
<CONSTANT TRAM-INTENSITY 20>
<CONSTANT CONSOLE-INTENSITY 20>
<GLOBAL DRONE-STATS <ITABLE 32 0>>

<ROOM DISPATCH (IN ROOMS) (FLAGS RLANDBIT ONBIT) (GLOBAL RAIN CITY RIVER BRIDGE-SPAN DISTANT-TRAM) (ACTION DISPATCH-F)>

<ROOM BRIDGE (IN ROOMS) (FLAGS RLANDBIT ONBIT) (GLOBAL RAIN CITY RIVER BRIDGE-SPAN STATION STATION-DOOR) (ACTION BRIDGE-F)>
<ROOM RELAY (IN ROOMS) (FLAGS RLANDBIT ONBIT) (GLOBAL RAIN CITY RIVER BRIDGE-SPAN STATION STATION-DOOR) (ACTION RELAY-F)>

<OBJECT VANGUARD (IN DISPATCH) (FLAGS NDESCBIT) (ACTION PROFILE-F)>
<OBJECT ARC (IN DISPATCH) (FLAGS NDESCBIT) (ACTION PROFILE-F)>

<OBJECT LENS (IN DISPATCH) (FLAGS NDESCBIT) (ACTION PROFILE-F)>
<OBJECT DUTY-BOARD (IN DISPATCH) (FLAGS NDESCBIT) (ACTION DUTY-BOARD-F)>

<OBJECT WINDOW (IN DISPATCH) (FLAGS NDESCBIT) (ACTION WINDOW-F)>
<OBJECT DOSSIER (FLAGS TAKEBIT READBIT) (ACTION SHEET-F)>

<OBJECT TRAM (IN BRIDGE) (FLAGS NDESCBIT) (ACTION TRAM-F)>
<OBJECT CREW (IN BRIDGE) (FLAGS NDESCBIT ACTORBIT) (ACTION CREW-F)>

<OBJECT RAILS (IN BRIDGE) (FLAGS NDESCBIT) (ACTION RAILS-F)>
<OBJECT CABLE (IN BRIDGE) (FLAGS NDESCBIT) (ACTION CABLE-F)>

<OBJECT DRONE (IN RELAY) (FLAGS NDESCBIT ACTORBIT) (ACTION DRONE-F)>
<OBJECT CONSOLE (IN RELAY) (FLAGS NDESCBIT) (ACTION CONSOLE-F)>

<OBJECT SUPPLIES (IN RELAY) (FLAGS NDESCBIT) (ACTION KIT-F)>
<OBJECT RAIN (IN LOCAL-GLOBALS) (FLAGS NDESCBIT) (ACTION RAIN-F)>

<OBJECT CITY (IN LOCAL-GLOBALS) (FLAGS NDESCBIT) (ACTION CITY-F)>
<OBJECT RIVER (IN LOCAL-GLOBALS) (FLAGS NDESCBIT) (ACTION RIVER-F)>

<OBJECT BRIDGE-SPAN (IN LOCAL-GLOBALS) (FLAGS NDESCBIT) (ACTION BRIDGE-SPAN-F)>
<OBJECT DISTANT-TRAM (IN LOCAL-GLOBALS) (FLAGS NDESCBIT) (ACTION DISTANT-TRAM-F)>

<OBJECT STATION (IN LOCAL-GLOBALS) (FLAGS NDESCBIT) (ACTION STATION-F)>
<OBJECT STATION-DOOR (IN LOCAL-GLOBALS) (FLAGS NDESCBIT) (ACTION STATION-DOOR-F)>


<ROUTINE V-BOOK-HELP ()
 <MSG-HELP-HOW>
 <COND (<0? ,HERO-CLASS> <MSG-HELP-UNREGISTERED>)
       (<NOT ,RESCUED> <MSG-HELP-RESCUE>)
       (T <MSG-HELP-RELAY>)>>

<ROUTINE V-BOOK-LISTEN ()
 <COND (<EQUAL? ,HERE ,DISPATCH> <MSG-LISTEN-DISPATCH>)
       (<EQUAL? ,HERE ,BRIDGE> <MSG-LISTEN-BRIDGE>)
       (,DISABLED <MSG-LISTEN-RELAY-DRONE-DOWN>)
       (T <MSG-LISTEN-RELAY>)>>

<ROUTINE HERO-PRINT-NAME ()
 <COND (<NAMED?> <PRINT-NAME>) (T <MSG-DEFAULT-NAME>)>>

<ROUTINE HERO-PRINT-CLASS () <RPG-PRESET-TITLE ,HERO-CLASS>>

;"Damage from a failed or answered action: the cost, then the Health left,
  then the ending if nothing is left."
<ROUTINE HERO-HURT (AMOUNT)
 <LOSE ,HERO ,A-HEALTH .AMOUNT>
 <MSG-HERO-HURT <STAT ,HERO ,A-HEALTH> <MAX-STAT ,HERO ,A-HEALTH>>
 <HERO-LOSS-CHECK>>

<ROUTINE HERO-LOSS-CHECK ()
 <COND (<0? <STAT ,HERO ,A-HEALTH>>
        <CRLF>
        <COND (<EQUAL? ,HERE ,RELAY> <MSG-LOSS-RELAY>)
              (T <MSG-LOSS-BRIDGE>)>
        <MSG-LOSS-ENDING>
        <FINISH>)>>

;"JUMP with nothing to jump is fatal in the base wherever DOWN is a refusal
  string, as on the bridge; here it is only a thought."
<ROUTINE ROOM-BEG ()
 <COND (<AND <VERB? LEAP> <NOT ,PRSO>>
        <COND (<EQUAL? ,HERE ,BRIDGE> <MSG-LEAP-BRIDGE>)
              (T <MSG-LEAP-IDLE>)>)
       (<AND <VERB? SWIM> <NOT ,PRSO>> <PERFORM ,V?SWIM ,RIVER> <RTRUE>)>>



<ROUTINE DISPATCH-F (RARG)
 <COND (<EQUAL? .RARG ,M-BEG> <ROOM-BEG>)
       (<EQUAL? .RARG ,M-LOOK>
        <COND (<0? ,HERO-CLASS>
               <MSG-SETUP>)
              (T
               <MSG-DISPATCH-LOOK-REGISTERED>)>
        <CRLF>)>>

<ROUTINE BRIDGE-F (RARG)
 <COND (<EQUAL? .RARG ,M-BEG> <ROOM-BEG>)
       (<EQUAL? .RARG ,M-LOOK>
        <MSG-BRIDGE-LOOK-START>
        <COND (,RESCUED <MSG-BRIDGE-LOOK-RESCUED>)
              (T <MSG-BRIDGE-LOOK-HANGING>)>
        <MSG-BRIDGE-LOOK-END>)>>

<ROUTINE RELAY-F (RARG)
 <COND (<EQUAL? .RARG ,M-BEG> <ROOM-BEG>)
       (<EQUAL? .RARG ,M-LOOK>
        <MSG-RELAY-LOOK-START>
        <COND (,DISABLED <MSG-RELAY-LOOK-DRONE-DOWN>)
              (T <MSG-RELAY-LOOK-DRONE-UP>)>
        <COND (,BOOSTED <MSG-RELAY-LOOK-KIT-EMPTY>)
              (T <MSG-RELAY-LOOK-KIT-FULL>)>)>>

<ROUTINE PROFILE-F ()
 <COND (<VERB? EXAMINE READ>
        <RPG-PRESET-SUMMARY <PROFILE-CLASS ,PRSO>>
        <COND (<==? ,HERO-CLASS <PROFILE-CLASS ,PRSO>> <MSG-PROFILE-IS-YOURS>)
              (<0? ,HERO-CLASS> <MSG-PROFILE-TO-CHOOSE>)>
        <CRLF> <RTRUE>)
       (<VERB? TAKE> <MSG-PROFILE-TAKE>)
       (<VERB? RPG-CHOOSE USE>
        <COND (<NOT <0? ,HERO-CLASS>>
               <MSG-CHOOSE-ALREADY-1> <HERO-PRINT-CLASS>
               <MSG-CHOOSE-ALREADY-2> <RTRUE>)>
        <COND (<NOT <RPG-SELECT-PRESET <PROFILE-CLASS ,PRSO>>> <RFALSE>)>
        <SETG HERO-CLASS ,RPG-PRESET-INDEX>
        <MSG-CHOOSE-REGISTERED-1> <HERO-PRINT-CLASS> <MSG-CHOOSE-REGISTERED-2>
        <PRINT-SHEET ,HERO>
        <RPG-BEGIN ,OPEN-MISSION> <RTRUE>)
       (<VERB? RPG-ATTACK> <MSG-PROFILE-ATTACK>)>>

<ROUTINE PROFILE-CLASS (OBJ)
 <COND (<EQUAL? .OBJ ,VANGUARD> 1) (<EQUAL? .OBJ ,ARC> 2) (T 3)>>

<ROUTINE DUTY-BOARD-F ()
 <COND (<VERB? EXAMINE READ>
        <COND (<0? ,HERO-CLASS> <MSG-BOARD-LOOK-UNREGISTERED>)
              (<==? ,HERO-CLASS 1> <MSG-BOARD-LOOK-BULWARK>)
              (<==? ,HERO-CLASS 2> <MSG-BOARD-LOOK-ARC>)
              (T <MSG-BOARD-LOOK-LENS>)>)
       (<VERB? TAKE MOVE PUSH> <MSG-DUTY-BOARD-TAKE>)
       (<VERB? RPG-ATTACK> <MSG-DUTY-BOARD-ATTACK>)>>

<ROUTINE WINDOW-F ()
 <COND (<VERB? EXAMINE LOOK-INSIDE>
        <MSG-WINDOW-EXAMINE>)
       (<VERB? OPEN> <MSG-WINDOW-OPEN>)
       (<VERB? CLOSE> <MSG-WINDOW-CLOSE>)
       (<VERB? RUB> <MSG-WINDOW-RUB>)
       (<VERB? RPG-ATTACK> <MSG-WINDOW-ATTACK>)>>

<ROUTINE SHEET-F ("AUX" STATUS)
 <COND (<VERB? EXAMINE READ>
        <MSG-SHEET-HERO> <HERO-PRINT-NAME>
        <COND (<0? ,HERO-CLASS> <MSG-SHEET-UNREGISTERED> <RTRUE>)>
        <MSG-SHEET-OPEN-CLASS> <HERO-PRINT-CLASS> <MSG-SHEET-CLOSE-CLASS> <PRINT-SHEET ,HERO> <RTRUE>)
       (<VERB? RPG-NAME>
        <SET STATUS <ASK-NAME>>
        <COND (<0? .STATUS> <MSG-NAME-REFUSED-1> <HERO-PRINT-NAME> <MSG-NAME-REFUSED-2>)
              (<==? .STATUS 1> <MSG-NAME-BLANK-1> <HERO-PRINT-NAME> <MSG-NAME-BLANK-2>)
              (T <MSG-NAME-STORED> <HERO-PRINT-NAME> <CRLF>)>
        <RTRUE>)
       (<VERB? DROP PUT PUT-ON GIVE THROW>
        <MSG-SHEET-DROP>)
       (<VERB? RPG-ATTACK> <MSG-SHEET-ATTACK>)>>

<ROUTINE HERO-RESCUE-ATTR ()
 <COND (<==? ,HERO-CLASS 1> <MSG-CHECK-STRENGTH> ,A-STRENGTH)
       (<==? ,HERO-CLASS 2> <MSG-CHECK-AGILITY> ,A-AGILITY)
       (T <MSG-CHECK-POWER> ,A-POWER)>>

<ROUTINE TRAM-F ()
 <COND (<VERB? EXAMINE LOOK-INSIDE>
        <COND (,RESCUED <MSG-TRAM-EXAMINE-RESCUED>)
              (T <MSG-TRAM-EXAMINE>)>)
       (<VERB? LISTEN>
        <COND (,RESCUED <MSG-TRAM-LISTEN-RESCUED>)
              (T <MSG-TRAM-LISTEN>)>)
       (<VERB? PUSH> <MSG-TRAM-PUSH>)
       (<VERB? RPG-ATTACK> <MSG-TRAM-ATTACK>)
       (<VERB? RPG-RESCUE PULL MOVE RAISE CLIMB-ON CLIMB-FOO THROUGH TAKE USE>
        <COND (<0? ,HERO-CLASS> <MSG-TRAM-RESCUE-UNREGISTERED> <RTRUE>)>
        <COND (,RESCUED <MSG-TRAM-RESCUE-RESCUED>)
              (<FASERIP-FEAT ,HERO <HERO-RESCUE-ATTR> ,TRAM-INTENSITY>
               <SETG RESCUED T> <GAIN ,HERO ,A-KARMA 10>
               <MSG-TRAM-RESCUED-NOW>)
              (T <MSG-TRAM-RESCUE-FAILED> <HERO-HURT 5>)>
        <RTRUE>)>>

<ROUTINE CREW-F ()
 <COND (<VERB? EXAMINE>
        <COND (,RESCUED <MSG-CREW-EXAMINE-RESCUED>)
              (T <MSG-CREW-EXAMINE>)>)
       (<VERB? TELL HELLO ANSWER YELL>
        <COND (,RESCUED <MSG-CREW-TELL-RESCUED>)
              (T <MSG-CREW-TELL>)>
        <SETG P-CONT <>> <SETG QUOTE-FLAG <>> <RTRUE>)
       (<VERB? RPG-ATTACK> <MSG-CREW-ATTACK>)
       (<VERB? LISTEN> <MSG-CREW-LISTEN>)>>

<ROUTINE RAILS-F ()
 <COND (<VERB? EXAMINE> <MSG-RAILS-EXAMINE>)
       (<VERB? LEAP> <PERFORM ,V?SWIM ,RIVER> <RTRUE>)
       (<VERB? CLIMB-ON CLIMB-FOO CLIMB-UP> <MSG-RAILS-CLIMB-ON>)
       (<VERB? TAKE PULL MOVE PUSH RAISE> <MSG-RAILS-TAKE>)
       (<VERB? RUB> <MSG-RAILS-RUB>)
       (<VERB? RPG-ATTACK> <MSG-RAILS-ATTACK>)>>

<ROUTINE CABLE-F ()
 <COND (<VERB? EXAMINE>
        <COND (,RESCUED <MSG-CABLE-EXAMINE-RESCUED>)
              (T <MSG-CABLE-EXAMINE>)>)
       (<VERB? LISTEN> <MSG-CABLE-LISTEN>)
       (<VERB? RUB> <MSG-CABLE-RUB>)
       (<VERB? RPG-ATTACK> <MSG-CABLE-ATTACK>)
       (<VERB? TAKE PULL MOVE RAISE CLIMB-ON CLIMB-FOO CLIMB-UP RPG-RESCUE>
        <COND (,RESCUED <MSG-CABLE-TAKE-RESCUED>)
              (T <PERFORM ,V?RPG-RESCUE ,TRAM>)>
        <RTRUE>)>>

;"A failed or answered strike lets the drone counter while it still flies."
<ROUTINE DRONE-F ()
 <COND (<VERB? EXAMINE>
        <COND (,DISABLED <MSG-DRONE-EXAMINE-DISABLED>)
              (T <MSG-DRONE-EXAMINE <STAT ,DRONE-STATS ,A-HEALTH> <MAX-STAT ,DRONE-STATS ,A-HEALTH>>)>)
       (<VERB? LISTEN>
        <COND (,DISABLED <MSG-DRONE-LISTEN-DISABLED>) (T <MSG-DRONE-LISTEN>)>)
       (<VERB? TELL HELLO ANSWER YELL>
        <COND (,DISABLED <MSG-DRONE-TELL-DISABLED>)
              (T <MSG-DRONE-TELL>)>
        <SETG P-CONT <>> <SETG QUOTE-FLAG <>> <RTRUE>)
       (<VERB? TAKE RUB PUSH PULL MOVE>
        <COND (,DISABLED <MSG-DRONE-TAKE-DISABLED>)
              (T <MSG-DRONE-TAKE>)>)
       (<VERB? RPG-DISABLE>
        <COND (,DISABLED <MSG-DRONE-DISABLE-DISABLED>) (T <PERFORM ,V?RPG-ATTACK ,DRONE>)> <RTRUE>)
       (<VERB? RPG-ATTACK>
        <COND (<0? ,HERO-CLASS> <MSG-DRONE-ATTACK-UNREGISTERED> <RTRUE>)>
        <COND (,DISABLED <MSG-DRONE-ATTACK-DISABLED> <RTRUE>)>
        <MSG-DRONE-CHECK>
        <COND (<CHECK ,HERO ,A-FIGHTING 0 1>
               <LOSE ,DRONE-STATS ,A-HEALTH <STAT ,HERO ,A-POWER>>
               <COND (<0? <STAT ,DRONE-STATS ,A-HEALTH>>
                      <SET-STAT ,DRONE-STATS ,A-HEALTH 0> <SETG DISABLED T> <GAIN ,HERO ,A-KARMA 10>
                      <MSG-DRONE-DOWN>)
                     (T <MSG-DRONE-HIT <STAT ,DRONE-STATS ,A-HEALTH> <MAX-STAT ,DRONE-STATS ,A-HEALTH>>)>)
              (T <MSG-DRONE-MISS>)>
        <COND (<NOT ,DISABLED> <MSG-DRONE-COUNTER> <HERO-HURT 10>)>
        <RTRUE>)>>

<ROUTINE CONSOLE-F ()
 <COND (<VERB? EXAMINE>
        <MSG-CONSOLE-EXAMINE>
        <COND (<NOT ,DISABLED>
               <MSG-CONSOLE-EXAMINE-NOT-DISABLED> <CRLF>
               <FASERIP-CHALLENGE ,CONSOLE-INTENSITY
                <FASERIP-REQUIRED <FASERIP-COLUMN <STAT ,HERO ,A-REASON>> ,CONSOLE-INTENSITY>>)
              (T <CRLF>)>)
       (<VERB? RUB LISTEN> <MSG-CONSOLE-RUB>)
       (<VERB? TAKE> <MSG-CONSOLE-TAKE>)
       (<VERB? RPG-ATTACK> <MSG-CONSOLE-ATTACK>)
       (<VERB? RPG-DISABLE PULL MOVE PUSH TURN OPEN USE>
        <COND (<0? ,HERO-CLASS> <MSG-CONSOLE-DISABLE-UNREGISTERED> <RTRUE>)>
        <COND (<OR ,DISABLED <HERO-CHECK-REASON>>
               <SETG DISABLED T> <SET-STAT ,DRONE-STATS ,A-HEALTH 0> <GAIN ,HERO ,A-KARMA 20>
               <MSG-CONSOLE-WIN-START>
               <HERO-PRINT-NAME> <MSG-CONSOLE-WIN-END>
               <FINISH>)
              (T <MSG-CONSOLE-COUNTER> <HERO-HURT 10>)>
        <RTRUE>)>>

<ROUTINE HERO-CHECK-REASON ()
 <MSG-CHECK-REASON>
 <FASERIP-FEAT ,HERO ,A-REASON ,CONSOLE-INTENSITY>>

<ROUTINE KIT-F ()
 <COND (<VERB? EXAMINE>
        <COND (,BOOSTED <MSG-KIT-EXAMINE-BOOSTED>)
              (T <MSG-KIT-EXAMINE>)>)
       (<VERB? TAKE> <MSG-KIT-TAKE>)
       (<VERB? RPG-ATTACK> <MSG-KIT-ATTACK>)
       (<VERB? RPG-POWER USE OPEN>
        <COND (<0? ,HERO-CLASS> <MSG-KIT-POWER-UNREGISTERED> <RTRUE>)>
        <COND (,BOOSTED <MSG-KIT-POWER-BOOSTED>)
              (<NOT <L? <STAT ,HERO ,A-HEALTH> <MAX-STAT ,HERO ,A-HEALTH>>> <MSG-KIT-UNHURT>)
              (<SPEND ,HERO ,A-KARMA 10>
               <SETG BOOSTED T>
               <MSG-KIT-USED <GAIN ,HERO ,A-HEALTH 20> <STAT ,HERO ,A-HEALTH> <MAX-STAT ,HERO ,A-HEALTH> <STAT ,HERO ,A-KARMA>>)
              (T <MSG-KIT-NO-KARMA <STAT ,HERO ,A-KARMA>>)>
        <RTRUE>)>>

<ROUTINE RAIN-F ()
 <COND (<VERB? EXAMINE>
        <COND (<EQUAL? ,HERE ,DISPATCH> <MSG-RAIN-DISPATCH>)
              (<EQUAL? ,HERE ,BRIDGE> <MSG-RAIN-BRIDGE>)
              (T <MSG-RAIN-EXAMINE>)>)
       (<VERB? LISTEN> <MSG-RAIN-LISTEN>)
       (<VERB? SMELL> <MSG-RAIN-SMELL>)
       (<VERB? TAKE RUB> <MSG-RAIN-TAKE>)>>

<ROUTINE CITY-F ()
 <COND (<VERB? EXAMINE> <MSG-CITY-EXAMINE>)
       (<VERB? LISTEN> <MSG-CITY-LISTEN>)>>

<ROUTINE RIVER-F ()
 <COND (<VERB? EXAMINE> <MSG-RIVER-EXAMINE>)
       (<VERB? SWIM LEAP THROUGH> <MSG-RIVER-SWIM>)
       (<VERB? DRINK> <MSG-RIVER-DRINK>)
       (<VERB? LISTEN> <MSG-RIVER-LISTEN>)>>

<ROUTINE BRIDGE-SPAN-F ()
 <COND (<VERB? EXAMINE>
        <COND (<EQUAL? ,HERE ,DISPATCH> <MSG-BRIDGE-SPAN-DISPATCH>)
              (<EQUAL? ,HERE ,BRIDGE> <MSG-BRIDGE-SPAN-BRIDGE>)
              (T <MSG-BRIDGE-SPAN-EXAMINE>)>)
       (<VERB? THROUGH CLIMB-ON WALK-TO>
        <COND (<EQUAL? ,HERE ,DISPATCH> <WALK-TO-BRIDGE>)
              (<EQUAL? ,HERE ,RELAY> <WALK-TO-BRIDGE>)
              (T <MSG-BRIDGE-SPAN-THROUGH>)>
        <RTRUE>)
       (<VERB? LEAP> <PERFORM ,V?SWIM ,RIVER> <RTRUE>)>>

<ROUTINE DISTANT-TRAM-F ()
 <COND (<VERB? EXAMINE> <MSG-DISTANT-TRAM-EXAMINE>)
       (<VERB? RPG-RESCUE> <MSG-DISTANT-TRAM-RESCUE>)>>

<ROUTINE STATION-F ()
 <COND (<VERB? EXAMINE>
        <COND (<EQUAL? ,HERE ,RELAY> <MSG-STATION-INSIDE>)
              (T <MSG-STATION-EXAMINE>)>)
       (<VERB? THROUGH WALK-TO>
        <COND (<EQUAL? ,HERE ,RELAY> <MSG-STATION-ALREADY-INSIDE>) (T <WALK-TO-RELAY>)>
        <RTRUE>)
       (<VERB? LISTEN> <MSG-STATION-LISTEN>)>>

<ROUTINE STATION-DOOR-F ()
 <COND (<VERB? EXAMINE> <MSG-STATION-DOOR-EXAMINE>)
       (<VERB? CLOSE LOCK> <MSG-STATION-DOOR-CLOSE>)
       (<VERB? OPEN> <MSG-STATION-DOOR-OPEN>)
       (<VERB? KNOCK> <MSG-STATION-DOOR-KNOCK>)
       (<VERB? THROUGH>
        <COND (<EQUAL? ,HERE ,RELAY> <WALK-TO-BRIDGE>) (T <WALK-TO-RELAY>)>
        <RTRUE>)>>
