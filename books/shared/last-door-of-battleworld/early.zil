;"The first two scenes: a choice of trust and a repair under fire."
<GLOBAL BW-SHIELD <>>
<GLOBAL BW-SHIELD-POWER-TRIED <>>
<ROOM LANDING (IN ROOMS) (FLAGS RLANDBIT ONBIT) (NORTH TO RIDGE) (ACTION BW-LANDING-F)>
<ROOM RIDGE (IN ROOMS) (FLAGS RLANDBIT ONBIT) (SOUTH TO LANDING)
 (NORTH PER BW-CAMP-EXIT) (ACTION BW-RIDGE-F)>
<OBJECT MAGNETO (IN LANDING) (FLAGS NDESCBIT ACTORBIT) (ACTION BW-MAGNETO-F)>
<OBJECT BW-WRECK (IN LANDING) (FLAGS NDESCBIT TRYTAKEBIT) (ACTION BW-WRECK-F)>
<OBJECT COIL (IN LANDING) (FLAGS TAKEBIT) (SIZE 2) (ACTION BW-COIL-F)>
<OBJECT RELAY (IN RIDGE) (FLAGS NDESCBIT TRYTAKEBIT CONTBIT OPENBIT) (CAPACITY 12) (ACTION BW-RELAY-F)>
<OBJECT RIDGE-ATTACK (IN RIDGE) (FLAGS NDESCBIT TRYTAKEBIT) (ACTION BW-ATTACK-F)>
<ROUTINE BW-LANDING-F (RARG) <COND (<EQUAL? .RARG ,M-LOOK> <MSG-LANDING> <RTRUE>)>>
<ROUTINE BW-RIDGE-F (RARG) <COND (<EQUAL? .RARG ,M-LOOK> <MSG-RIDGE> <RTRUE>)>>
<ROUTINE BW-CAMP-EXIT () <COND (,BW-SHIELD ,CAMP) (T <MSG-ATTACK> <RFALSE>)>>
<ROUTINE BW-MAGNETO-F ()
 <COND (<VERB? EXAMINE TALK TELL HELLO ANSWER ASK LISTEN RPG-ATTACK RPG-POWER>
        <MSG-MAGNETO> <SETG P-CONT <>> <SETG QUOTE-FLAG <>> <RTRUE>)>>
<ROUTINE BW-WRECK-F ()
 <COND (<VERB? EXAMINE SEARCH LOOK-INSIDE TOUCH TAKE> <MSG-WRECK> <RTRUE>)>>
<ROUTINE BW-COIL-F () <COND (<VERB? EXAMINE READ SEARCH> <MSG-COIL> <RTRUE>)>>
<ROUTINE BW-RELAY-F ()
 <COND (<AND <VERB? PUT PUT-ON BW-FIT> <EQUAL? ,PRSI ,RELAY> <EQUAL? ,PRSO ,COIL>>
        <BW-FIX-RELAY> <RTRUE>)
       (<EQUAL? ,PRSO ,RELAY>
        <COND (<VERB? EXAMINE READ SEARCH OPEN LOOK-INSIDE> <MSG-RELAY> <RTRUE>)
              (<VERB? RPG-POWER> <BW-POWER-SHIELD> <RTRUE>)
              (<VERB? USE PUSH> <BW-FIX-RELAY> <RTRUE>)>)>>
<ROUTINE BW-FIX-RELAY ()
 <COND (,BW-SHIELD <MSG-RELAY-DONE>)
       (<IN? ,COIL ,WINNER> <SETG BW-SHIELD T> <REMOVE ,COIL> <MSG-RELAY-FIXED>)
       (T <MSG-RELAY>)>>
<ROUTINE BW-ATTACK-F ()
 <COND (<VERB? EXAMINE LISTEN TALK TELL RPG-ATTACK RPG-POWER USE> <COND (,BW-SHIELD <MSG-RELAY-DONE>) (T <MSG-ATTACK>)> <RTRUE>)>>

<ROUTINE BW-POWER-SHIELD ("AUX" ATTR)
 <COND (,BW-SHIELD <MSG-RELAY-DONE> <RTRUE>)
       (,BW-SHIELD-POWER-TRIED <MSG-SHIELD-FAIL> <RTRUE>)>
 <SETG BW-SHIELD-POWER-TRIED T>
 <SET ATTR <COND (<EQUAL? ,RPG-PRESET-INDEX 1> ,A-AGILITY)
                 (<EQUAL? ,RPG-PRESET-INDEX 2> ,A-POWER)
                 (T ,A-REASON)>>
 <COND (<FASERIP-FEAT ,HERO .ATTR 30>
        <SETG BW-SHIELD T> <MSG-SHIELD-POWER> <MSG-EARLY-OBJECTIVE>)
       (T <MSG-SHIELD-FAIL>)>>
