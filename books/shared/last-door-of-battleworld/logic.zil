;"Original Book logic; both words files add descriptions and synonyms. The
  room names, power rolls, and all puzzle outcomes share one source."
<GLOBAL BW-SPIDER <LTABLE 20 40 30 30 20 40 10 30>>
<GLOBAL BW-STORM <LTABLE 10 30 6 30 20 30 40 50>>
<GLOBAL BW-IRON <LTABLE 30 20 50 40 40 20 20 40>>
<SETG RPG-PRESETS <LTABLE <TABLE "spider-man" BW-SPIDER>
                         <TABLE "storm" BW-STORM>
                         <TABLE "iron-man" BW-IRON>>>
<GLOBAL EVACUATED <>>
<GLOBAL BW-RESCUE-TRIED <>>
<GLOBAL BW-ASSISTED <>>
<GLOBAL BW-MIRROR-SEEN <>>
<GLOBAL BW-ALIGNED <>>
<GLOBAL BW-CHARGED <>>
<GLOBAL BW-WON <>>

<ROOM SETUP-DESK (IN ROOMS) (FLAGS RLANDBIT ONBIT) (ACTION BW-SETUP-F)>
<ROOM CAMP (IN ROOMS) (FLAGS RLANDBIT ONBIT) (NORTH TO SPAN) (ACTION BW-CAMP-F)>
<ROOM SPAN (IN ROOMS) (FLAGS RLANDBIT ONBIT) (SOUTH TO CAMP)
 (NORTH TO MARKET IF EVACUATED) (ACTION BW-SPAN-F)>
<ROOM MARKET (IN ROOMS) (FLAGS RLANDBIT ONBIT) (SOUTH TO SPAN) (EAST TO WORKSHOP)
 (NORTH TO TOWER) (ACTION BW-MARKET-F)>
<ROOM WORKSHOP (IN ROOMS) (FLAGS RLANDBIT ONBIT) (WEST TO MARKET) (ACTION BW-WORKSHOP-F)>
<ROOM TOWER (IN ROOMS) (FLAGS RLANDBIT ONBIT) (SOUTH TO MARKET) (ACTION BW-TOWER-F)>

<OBJECT CARD-SPIDER (IN SETUP-DESK) (FLAGS NDESCBIT) (ACTION BW-CARD-F)>
<OBJECT CARD-STORM (IN SETUP-DESK) (FLAGS NDESCBIT) (ACTION BW-CARD-F)>
<OBJECT CARD-IRON (IN SETUP-DESK) (FLAGS NDESCBIT) (ACTION BW-CARD-F)>
<OBJECT HELPER (IN CAMP) (FLAGS NDESCBIT ACTORBIT) (ACTION BW-HELPER-F)>
<OBJECT BEACON (IN CAMP) (FLAGS NDESCBIT TRYTAKEBIT) (ACTION BW-BEACON-F)>
<OBJECT SKIFF (IN SPAN) (FLAGS NDESCBIT TRYTAKEBIT) (ACTION BW-SKIFF-F)>
<OBJECT WINCH (IN SPAN) (FLAGS NDESCBIT TURNBIT TRYTAKEBIT) (ACTION BW-WINCH-F)>
<OBJECT MIRROR (IN MARKET) (FLAGS NDESCBIT TURNBIT READBIT TRYTAKEBIT) (ACTION BW-MIRROR-F)>
<OBJECT CACHE (IN MARKET) (FLAGS NDESCBIT CONTBIT TRYTAKEBIT) (CAPACITY 12) (ACTION BW-CACHE-F)>
<OBJECT CELL (IN CACHE) (FLAGS TAKEBIT) (SIZE 2) (ACTION BW-CELL-F)>
<OBJECT SOCKET (IN WORKSHOP) (FLAGS NDESCBIT TRYTAKEBIT CONTBIT OPENBIT) (CAPACITY 12) (ACTION BW-SOCKET-F)>
<OBJECT LOOM (IN TOWER) (FLAGS NDESCBIT TURNBIT TRYTAKEBIT) (ACTION BW-LOOM-F)>
<OBJECT DOOM (IN TOWER) (FLAGS NDESCBIT ACTORBIT) (ACTION BW-DOOM-F)>

<ROUTINE BW-SETUP-F (RARG)
 <COND (<EQUAL? .RARG ,M-LOOK> <MSG-SETUP> <RTRUE>)>>

<ROUTINE BW-CARD-F ("AUX" INDEX)
 <SET INDEX <COND (<EQUAL? ,PRSO ,CARD-SPIDER> 1) (<EQUAL? ,PRSO ,CARD-STORM> 2) (T 3)>>
 <COND (<VERB? EXAMINE READ TAKE> <RPG-PRESET-SUMMARY .INDEX> <CRLF> <RTRUE>)
       (<VERB? RPG-CHOOSE> <RPG-SELECT-PRESET .INDEX> <RPG-BEGIN ,BW-START> <RTRUE>)>>

<ROUTINE BW-CAMP-F (RARG) <COND (<EQUAL? .RARG ,M-LOOK> <MSG-CAMP> <RTRUE>)>>
<ROUTINE BW-SPAN-F (RARG)
 <COND (<EQUAL? .RARG ,M-LOOK>
        <COND (,EVACUATED <MSG-SPAN-CLEAR>) (T <MSG-SPAN>)> <RTRUE>)>>
<ROUTINE BW-MARKET-F (RARG) <COND (<EQUAL? .RARG ,M-LOOK> <MSG-MARKET> <RTRUE>)>>
<ROUTINE BW-WORKSHOP-F (RARG) <COND (<EQUAL? .RARG ,M-LOOK> <MSG-WORKSHOP> <RTRUE>)>>
<ROUTINE BW-TOWER-F (RARG) <COND (<EQUAL? .RARG ,M-LOOK> <MSG-TOWER> <RTRUE>)>>

<ROUTINE BW-HELPER-F ()
 <COND (<VERB? EXAMINE TALK TELL HELLO ANSWER ASK LISTEN>
        <MSG-HELPER> <SETG P-CONT <>> <SETG QUOTE-FLAG <>> <RTRUE>)>>

<ROUTINE BW-BEACON-F ()
 <COND (<EQUAL? ,PRSO ,BEACON>
        <COND (<VERB? EXAMINE READ LISTEN TAKE USE PUSH RPG-POWER>
               <MSG-BEACON> <RTRUE>)>)>>

<ROUTINE BW-SKIFF-F ()
 <COND (<EQUAL? ,PRSO ,SKIFF>
        <COND (<VERB? EXAMINE LISTEN TAKE ENTER CLIMB-ON>
               <COND (,EVACUATED <MSG-RESCUE-ALREADY>) (T <MSG-SKIFF>)> <RTRUE>)
              (<VERB? RPG-POWER RPG-RESCUE USE> <BW-TRY-RESCUE> <RTRUE>)>)>>

<ROUTINE BW-TRY-RESCUE ("AUX" ATTR)
 <COND (,EVACUATED <MSG-RESCUE-ALREADY> <RTRUE>)
       (,BW-RESCUE-TRIED <MSG-WINCH> <RTRUE>)>
 <SETG BW-RESCUE-TRIED T>
 <SET ATTR <COND (<EQUAL? ,RPG-PRESET-INDEX 1> ,A-AGILITY)
                 (<EQUAL? ,RPG-PRESET-INDEX 2> ,A-POWER)
                 (T ,A-REASON)>>
 <COND (<FASERIP-FEAT ,HERO .ATTR 30> <BW-SAVE-SKIFF <>>)
       (T <LOSE ,HERO ,A-HEALTH 5> <MSG-RESCUE-FAIL>)>>

<ROUTINE BW-SAVE-SKIFF (ASSISTED)
 <COND (,EVACUATED <MSG-RESCUE-ALREADY> <RTRUE>)>
 <SETG EVACUATED T> <SETG BW-ASSISTED .ASSISTED>
 <GAIN ,HERO ,A-KARMA 10>
 <COND (.ASSISTED <MSG-RESCUE-WINCH>) (T <MSG-RESCUE-SUCCESS>)>>

<ROUTINE BW-WINCH-F ()
 <COND (<EQUAL? ,PRSO ,WINCH>
        <COND (<VERB? EXAMINE LISTEN TAKE> <MSG-WINCH> <RTRUE>)
              (<VERB? MOVE PULL TURN BW-PULL BW-TURN USE RPG-POWER> <BW-SAVE-SKIFF T> <RTRUE>)>)>>

<ROUTINE BW-MIRROR-F ()
 <COND (<EQUAL? ,PRSO ,MIRROR>
        <COND (<VERB? EXAMINE READ SEARCH>
               <SETG BW-MIRROR-SEEN T> <MSG-MIRROR> <RTRUE>)
              (<VERB? TURN BW-TURN MOVE PUSH USE RPG-POWER>
               <COND (,BW-MIRROR-SEEN <SETG BW-ALIGNED T> <MSG-MIRROR-SET>)
                     (T <MSG-MIRROR-CLUE>)> <RTRUE>)
              (<VERB? TAKE LISTEN> <MSG-MIRROR-CLUE> <RTRUE>)>)>>

<ROUTINE BW-CACHE-F ()
 <COND (<EQUAL? ,PRSO ,CACHE>
        <COND (<VERB? OPEN> <FSET ,CACHE ,OPENBIT> <MSG-CACHE> <RTRUE>)
              (<VERB? EXAMINE TAKE> <MSG-CACHE> <RTRUE>)>)>>

<ROUTINE BW-CELL-F ()
 <COND (<VERB? EXAMINE READ LISTEN> <MSG-CELL> <RTRUE>)>>

<ROUTINE BW-SOCKET-F ()
 <COND (<AND <VERB? PUT PUT-ON> <EQUAL? ,PRSI ,SOCKET> <EQUAL? ,PRSO ,CELL>>
        <BW-INSTALL-CELL> <RTRUE>)
       (<EQUAL? ,PRSO ,SOCKET>
        <COND (<VERB? EXAMINE OPEN LOOK-INSIDE TAKE>
               <COND (,BW-CHARGED <MSG-SOCKET-ALREADY>) (T <MSG-SOCKET>)> <RTRUE>)
              (<VERB? USE RPG-POWER> <BW-INSTALL-CELL> <RTRUE>)>)>>

<ROUTINE BW-INSTALL-CELL ()
 <COND (,BW-CHARGED <MSG-SOCKET-ALREADY>)
       (<IN? ,CELL ,WINNER>
        <SETG BW-CHARGED T> <REMOVE ,CELL> <MSG-SOCKET-SET>)
       (T <MSG-SOCKET>)>>

<ROUTINE BW-DOOM-F ()
 <COND (<EQUAL? ,PRSO ,DOOM>
        <COND (<VERB? RPG-ATTACK RPG-POWER TAKE PUSH> <MSG-DOOM-STRIKE> <RTRUE>)
              (<VERB? EXAMINE ASK TELL TALK LISTEN HELLO ANSWER>
               <MSG-DOOM> <SETG P-CONT <>> <SETG QUOTE-FLAG <>> <RTRUE>)>)>>

<ROUTINE BW-LOOM-F ()
 <COND (<EQUAL? ,PRSO ,LOOM>
        <COND (<VERB? EXAMINE LISTEN READ OPEN TAKE> <MSG-LOOM> <RTRUE>)
              (<VERB? RPG-POWER>
               <COND (,BW-CHARGED <BW-FINISH 2>) (T <MSG-LOOM-BLOCK>)> <RTRUE>)
              (<VERB? USE TURN RPG-DISABLE>
               <COND (,BW-ALIGNED <BW-FINISH 1>)
                     (,BW-CHARGED <BW-FINISH 2>)
                     (T <MSG-LOOM-BLOCK>)> <RTRUE>)>)>>

<ROUTINE BW-FINISH (METHOD)
 <COND (,BW-WON <RTRUE>)>
 <SETG BW-WON .METHOD>
 <GAIN ,HERO ,A-KARMA 20>
 <COND (<EQUAL? .METHOD 1> <MSG-WIN-MIRROR>) (T <MSG-WIN-CELL>)>
 <COND (,BW-ASSISTED <MSG-END-ASSISTED>) (T <MSG-END-DIRECT>)>
 <FINISH>>
