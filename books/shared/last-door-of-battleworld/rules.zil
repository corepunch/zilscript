;"Session entry, status, and live sheet export."
<ROUTINE GO ()
 <SETG HERE ,SETUP-DESK> <SETG VERBOSE T> <SETG LIT T>
 <SETG WINNER ,ADVENTURER> <SETG PLAYER ,WINNER> <MOVE ,WINNER ,HERE>
 <RPG-PREPARE>
 <COND (<0? ,RPG-PRESET-INDEX> <V-LOOK>)
       (T <RPG-BEGIN ,BW-START> <SETG CLOCK-WAIT <>>)>
 <MAIN-LOOP> <AGAIN>>

<ROUTINE BW-START ()
 <SETG HERE ,CAMP> <MOVE ,WINNER ,HERE>
 <MSG-OPENING> <CRLF> <V-LOOK>>

<ROUTINE V-SCORE ("OPTIONAL" (ASK? T)) <V-RPG-STATUS>>
<ROUTINE V-USE () <MSG-THEME>>
<ROUTINE V-BW-TURN () <MSG-THEME>>
<ROUTINE V-BW-PULL () <MSG-THEME>>

<ROUTINE RPG-EXPORT-SHEET ("AUX" NAME)
 <COND (<NOT ,RPG-STARTED> <RFALSE>)>
 <COND (<NAMED?> <PRINT-NAME>) (T <RPG-PRESET-TITLE ,RPG-PRESET-INDEX>)>
 <SET NAME <TAKE-OUTPUT>>
 <RPG-PRESET-TITLE ,RPG-PRESET-INDEX>
 <SHEET-IDENTITY .NAME <TAKE-OUTPUT>>
 <EXPORT-SHEET-RANKS ,HERO ,FASERIP-SHEET-ROW>
 <RTRUE>>
