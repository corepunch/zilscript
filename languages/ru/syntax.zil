;"The shared parser uses these internal word IDs for sentence structure."
<SETG P-POSTNOMINAL-ADJECTIVE T>

<BUZZ AGAIN G OOPS A AN THE IS AND OF THEN ALL ONE BUT EXCEPT \. \, \" YES NO Y HERE>
<SYNONYM AGAIN СНОВА ПОВТОРИ>
<SYNONYM AND И>
<SYNONYM THEN ПОТОМ>
<SYNONYM ALL ВСЁ ВСЕ>
<SYNONYM YES ДА>
<SYNONYM NO НЕТ>

<SYNONYM NORTH СЕВЕР С>
<SYNONYM SOUTH ЮГ Ю>
<SYNONYM EAST ВОСТОК В>
<SYNONYM WEST ЗАПАД З>
<SYNONYM NE СЕВЕРО-ВОСТОК СВ>
<SYNONYM NW СЕВЕРО-ЗАПАД СЗ>
<SYNONYM SE ЮГО-ВОСТОК ЮВ>
<SYNONYM SW ЮГО-ЗАПАД ЮЗ>
<SYNONYM UP ВВЕРХ>
<SYNONYM DOWN ВНИЗ>
<SYNONYM IN ВНУТРЬ>
<SYNONYM OUT НАРУЖУ>

<SYNTAX WALK = V-WALK-AROUND>
<SYNTAX WALK OBJECT = V-WALK>
<SYNONYM WALK ИДТИ ИДИ ПОЙТИ НА>
<SYNTAX ОСМОТРЕТЬСЯ = V-LOOK>
<SYNONYM ОСМОТРЕТЬСЯ ОГЛЯНУТЬСЯ ОГЛЯНИСЬ>
<SYNTAX ОСМОТРЕТЬ OBJECT = V-EXAMINE>
<SYNONYM ОСМОТРЕТЬ ОСМОТРИ ИЗУЧИТЬ ИЗУЧИ>
<SYNTAX ПРОЧИТАТЬ OBJECT = V-READ>
<SYNONYM ПРОЧИТАТЬ ПРОЧТИ ПРОЧИТАЙ ЧИТАТЬ>
<SYNTAX ВЗЯТЬ OBJECT = V-TAKE>
<SYNONYM ВЗЯТЬ ВОЗЬМИ>
<SYNTAX ИНВЕНТАРЬ = V-INVENTORY>
<SYNTAX ЖДАТЬ = V-WAIT>
<SYNONYM ЖДАТЬ ПОДОЖДАТЬ ПОДОЖДИ>
<SYNTAX СЧЁТ = V-SCORE>
<SYNTAX ВЕРСИЯ = V-VERSION>

<SYNTAX ОТКРЫТЬ OBJECT = V-OPEN>
<SYNTAX ЗАКРЫТЬ OBJECT = V-CLOSE>
<SYNTAX БРОСИТЬ OBJECT = V-DROP>
<SYNTAX ПОТЕРЕТЬ OBJECT = V-RUB>
<SYNTAX ТОЛКНУТЬ OBJECT = V-PUSH>
<SYNTAX ПОТЯНУТЬ OBJECT = V-PULL>
<SYNTAX ПОСЛУШАТЬ OBJECT = V-LISTEN>
<SYNTAX ПОНЮХАТЬ OBJECT = V-SMELL>
<SYNTAX ПОТРОГАТЬ OBJECT = V-TOUCH>
<SYNTAX ЗАЛЕЗТЬ OBJECT = V-CLIMB-FOO>
<SYNTAX ВОЙТИ OBJECT = V-THROUGH>
<SYNTAX ПРЫГНУТЬ = V-LEAP>
<SYNTAX ПЛЫТЬ = V-SWIM>
<SYNTAX ПОСТУЧАТЬ OBJECT = V-KNOCK>
<SYNTAX ГОВОРИТЬ OBJECT = V-TELL>
<SYNTAX ГОВОРИТЬ OBJECT О OBJECT = V-ASK-ABOUT>
<SYNTAX RESTART = V-RESTART>
<SYNONYM RESTART НАЧАТЬ>
<SYNTAX SAVE = V-SAVE>
<SYNONYM SAVE СОХРАНИТЬ>
<SYNTAX RESTORE = V-RESTORE>
<SYNONYM RESTORE ЗАГРУЗИТЬ>
<SYNTAX QUIT = V-QUIT>
<SYNONYM QUIT ВЫЙТИ>
